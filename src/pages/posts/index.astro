---
import Base from '../../layouts/Base.astro';
import { published, url, topicsOf, topicSlug, byId } from '../../lib/content';
const posts=(await published('post')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()||byId(a,b));
---
<Base title="Articles" description="Scientific articles, explanations and computational notes."><div class="container page"><header class="page-heading"><p class="eyebrow">Writing</p><h1>Articles</h1></header><ul class="content-list">{posts.map(post=><li><p class="meta">{post.data.date.toISOString().slice(0,10)}</p><h2><a href={url('post',post.id)}>{post.data.title}</a></h2><p>{post.data.description}</p><p>{topicsOf(post).map(t=><a class="tag" href={`/topics/${topicSlug(t)}/`}>{t}</a>)}</p></li>)}</ul></div></Base>
