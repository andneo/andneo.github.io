---
import Base from '../layouts/Base.astro';
import HeroSim from '../components/HeroSim.astro';
import PublicationList from '../components/content/PublicationList.astro';
import {AUTHOR,CONTACT,HOME_POST_COUNT,HOME_PUBLICATION_COUNT,HOME_RESEARCH_COUNT} from '../config';
import {published,byId,url} from '../lib/content';
const projects=(await published('project')).sort((a,b)=>a.data.order-b.data.order||byId(a,b)).slice(0,HOME_RESEARCH_COUNT);
const posts=(await published('post')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()||byId(a,b)).slice(0,HOME_POST_COUNT);
const pubs=(await published('publications')).sort((a,b)=>b.data.year-a.data.year||byId(a,b)).slice(0,HOME_PUBLICATION_COUNT);
const courses=await published('courses');
---
<Base>
 <div class="container">
  <section class="landing-hero" id="about"><div><p class="eyebrow">{AUTHOR.title}</p><h1>{AUTHOR.name}</h1><div class="hero-bio" set:html={AUTHOR.bio}/><div class="hero-actions"><a class="btn btn-primary" href="/research/">Explore research</a><a class="btn" href="/cv/">Curriculum vitae</a></div></div><HeroSim/></section>
  <section class="home-section" id="research"><div class="section-header"><h2>Research</h2><a href="/research/">All research →</a></div><ul class="research-grid">{projects.map(p=><li><p class="eyebrow">{p.data.status}</p><h3><a href={url('project',p.id)}>{p.data.title}</a></h3><p>{p.data.description}</p></li>)}</ul></section>
  <section class="home-section" id="posts"><div class="section-header"><h2>Articles</h2><a href="/posts/">All articles →</a></div><ul class="content-list">{posts.map(p=><li><p class="meta">{p.data.date.toISOString().slice(0,10)}</p><h3><a href={url('post',p.id)}>{p.data.title}</a></h3><p>{p.data.description}</p></li>)}</ul></section>
  <section class="home-section"><div class="section-header"><h2>Courses</h2><a href="/courses/">All courses →</a></div><ul class="research-grid">{courses.map(c=><li><h3><a href={url('courses',c.id)}>{c.data.title}</a></h3><p>{c.data.description}</p></li>)}</ul></section>
  <section class="home-section" id="publications"><div class="section-header"><h2>Publications</h2><a href="/publications/">Full index →</a></div><PublicationList publications={pubs}/></section>
  <section class="home-section" id="contact"><h2>Contact</h2><p><a href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a> · {CONTACT.location}</p></section>
 </div>
</Base>
<style>
.landing-hero{display:grid;grid-template-columns:1fr 1.15fr;gap:clamp(2rem,5vw,5rem);align-items:center;padding-block:clamp(3rem,8vw,7rem)}h1{font-family:var(--font-serif);font-weight:400;font-size:clamp(2.8rem,5vw,4.5rem);margin-block:1rem 1.5rem}.hero-bio{font-size:1.05rem;color:var(--text-2);max-width:52ch}.hero-actions{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1.5rem}.home-section{padding-block:2rem;border-top:1px solid var(--border)}.section-header{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1rem}.section-header a{font-size:.85rem}.research-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:2rem;padding:0;list-style:none}.research-grid p{color:var(--text-2)}.research-grid h3{font-size:1.3rem}@media(max-width:800px){.landing-hero{grid-template-columns:1fr}.landing-hero scientific-hero{max-width:600px;width:100%}}
</style>
