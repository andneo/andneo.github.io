---
import Base from '../layouts/Base.astro';
import HomepageBackground from '../components/HomepageBackground.astro';
import CardGlyph from '../components/CardGlyph.astro';
import { AUTHOR, CONTACT, HOME_POST_COUNT, HOME_PUBLICATION_COUNT, HOME_RESEARCH_COUNT } from '../config';
import { published, byId, url } from '../lib/content';

const projects = (await published('project')).sort((a,b) => a.data.order - b.data.order || byId(a,b)).slice(0, HOME_RESEARCH_COUNT);
const posts = (await published('post')).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf() || byId(a,b)).slice(0, HOME_POST_COUNT);
const pubs = (await published('publications')).sort((a,b) => b.data.year - a.data.year || byId(a,b)).slice(0, HOME_PUBLICATION_COUNT);
const courses = await published('courses');
---
<Base>
  <div class="homepage-root">
    <div class="homepage-content">
      <section class="home-hero" id="about">
        <HomepageBackground />
        <div class="container hero-frame">
          <div class="hero-copy">
            <div class="hero-identity" data-field-quiet>
              <p class="hero-role">{AUTHOR.title}</p>
              <h1>{AUTHOR.name}</h1>
              <div class="hero-bio" set:html={AUTHOR.bio} />
            </div>
          </div>
        </div>
      </section>

      <section class="home-section" id="research">
        <div class="container section-frame">
          <header class="section-header">
            <h2>Research</h2>
            <a href="/research/">View all <span aria-hidden="true">↗</span></a>
          </header>
          <ol class="card-grid research-grid">
            {projects.map(project => <li>
              <a class="home-card" href={url('project', project.id)}>
                <div class="card-head">
                  <CardGlyph seed={project.data.title} />
                  {project.data.status && <span class="card-label">{project.data.status}</span>}
                </div>
                <div class="card-copy">
                  <h3>{project.data.title}</h3>
                  <p>{project.data.description}</p>
                </div>
                <div class="card-foot">
                  <span>{project.data.tags?.[0] ?? 'Research'}</span>
                  <span aria-hidden="true">↗</span>
                </div>
              </a>
            </li>)}
          </ol>
        </div>
      </section>

      <section class="home-section" id="posts">
        <div class="container section-frame">
          <header class="section-header">
            <h2>Blog posts</h2>
            <a href="/posts/">View all <span aria-hidden="true">↗</span></a>
          </header>
          <ol class="card-grid post-grid">
            {posts.map(post => <li>
              <article class="home-card post-card">
                <div class="card-head">
                  <CardGlyph seed={post.data.tags?.[0] ?? post.data.title} />
                  <span class="card-label">{post.data.tags?.[0] ?? 'Article'}</span>
                </div>
                <div class="card-copy">
                  <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-GB', {day:'2-digit', month:'short', year:'numeric'})}</time>
                  <h3><a href={url('post', post.id)}>{post.data.title}</a></h3>
                  <p>{post.data.description}</p>
                </div>
                <div class="card-foot">
                  <span>{post.data.tags?.slice(1,3).join(' · ') || 'Notes'}</span>
                  <span aria-hidden="true">→</span>
                </div>
              </article>
            </li>)}
          </ol>
        </div>
      </section>

      <section class="home-section home-publications" id="publications">
        <div class="container section-frame">
          <header class="section-header">
            <h2>Publications</h2>
            <a href="/publications/">View all <span aria-hidden="true">↗</span></a>
          </header>
          <ol class="card-grid publication-grid">
            {pubs.map(pub => <li>
              <a class="home-card publication-card" href={url('publications', pub.id)}>
                <div class="card-head">
                  <CardGlyph seed={pub.data.title} />
                  <span class="card-label">{pub.data.type}</span>
                </div>
                <div class="card-copy">
                  <p class="publication-year">{pub.data.year}{pub.data.journal ? ` · ${pub.data.journal}` : ''}</p>
                  <h3>{pub.data.title}</h3>
                  <p>{pub.data.authors.join(', ')}</p>
                </div>
                <div class="card-foot">
                  <span>{pub.data.status}</span>
                  <span aria-hidden="true">↗</span>
                </div>
              </a>
            </li>)}
          </ol>
        </div>
      </section>

      <section class="home-section" id="courses">
        <div class="container section-frame">
          <header class="section-header">
            <h2>Lecture notes</h2>
            <a href="/courses/">View all <span aria-hidden="true">↗</span></a>
          </header>
          <ol class="card-grid course-grid">
            {courses.map(course => <li>
              <a class="home-card course-card" href={url('courses', course.id)}>
                <div class="card-head">
                  <CardGlyph seed={course.data.title} />
                  <span class="card-label">{course.data.level ?? 'Course'}</span>
                </div>
                <div class="card-copy">
                  <h3>{course.data.title}</h3>
                  <p>{course.data.description}</p>
                </div>
                <div class="card-foot">
                  <span>{course.data.status}</span>
                  <span aria-hidden="true">↗</span>
                </div>
              </a>
            </li>)}
          </ol>
        </div>
      </section>

      <section class="home-contact" id="contact">
        <div class="container contact-frame">
          <h2>Contact</h2>
          <p><a href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a></p>
          <p>{CONTACT.location}</p>
        </div>
      </section>
    </div>
  </div>
</Base>
<style>
  .homepage-root { position: relative; isolation: isolate; overflow: clip; }
  .homepage-content { position: relative; z-index: 1; }
  .home-hero,.home-section,.home-contact { position: relative; }
  .home-hero { overflow:hidden; background:var(--bg); }
  .home-section::before,.home-contact::before { content:''; position:absolute; inset:0; z-index:-1; pointer-events:none; }

  .hero-frame { position:relative; z-index:2; min-height:clamp(650px,80svh,840px); display:flex; align-items:center; justify-content:center; padding-block:clamp(7rem,13vh,10rem) clamp(5rem,10vh,7rem); }
  .hero-copy { width:min(100%,1040px); margin-inline:auto; }
  .hero-identity { width:100%; min-height:clamp(350px,44svh,440px); display:flex; flex-direction:column; justify-content:center; padding:clamp(2.2rem,4.5vw,4.4rem) clamp(2rem,5vw,5rem); border:1px solid var(--panel-border); border-radius:clamp(28px,3.2vw,42px); background:color-mix(in srgb,var(--surface) 78%,transparent); box-shadow:0 22px 70px -58px rgb(30 32 34 / .45); backdrop-filter:blur(4px); }
  .hero-role { margin:0 0 1rem; color:var(--signal); font:650 .76rem/1.2 var(--font-sans); letter-spacing:.105em; text-transform:uppercase; }
  h1 { max-width:20ch; margin:0; font:600 clamp(2.45rem,4.4vw,4.25rem)/1 var(--font-display); letter-spacing:-.05em; }
  .hero-bio { max-width:78ch; margin-top:clamp(1.6rem,3vw,2.45rem); color:var(--text-2); font-size:clamp(1.02rem,.98rem + .24vw,1.18rem); line-height:1.76; }

  .home-section { padding-block:clamp(4.75rem,8vw,7.5rem); }
  .home-section::before { background:linear-gradient(90deg,var(--home-scrim) 0 16%,transparent 45% 58%,var(--home-scrim) 100%); opacity:.76; }
  .home-publications::before { background:linear-gradient(180deg,transparent,var(--home-scrim) 36%,var(--home-scrim-strong)); }
  .section-frame { position:relative; }
  .section-header { display:flex; align-items:end; justify-content:space-between; gap:2rem; margin-bottom:clamp(1.75rem,3vw,2.75rem); padding-bottom:.9rem; border-bottom:1px solid var(--border-med); }
  .section-header h2 { margin:0; font:600 clamp(1.8rem,2.9vw,2.8rem)/1 var(--font-display); letter-spacing:-.035em; }
  .section-header > a { flex:none; color:var(--text-2); font:600 .86rem/1.2 var(--font-sans); letter-spacing:.01em; text-decoration:none; }
  .section-header > a:hover { color:var(--signal); }

  .card-grid { display:grid; gap:clamp(.85rem,1.5vw,1.3rem); margin:0; padding:0; list-style:none; }
  .card-grid > li { min-width:0; display:flex; }
  .research-grid { grid-template-columns:repeat(4,minmax(0,1fr)); }
  .course-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
  .post-grid { grid-template-columns:repeat(5,minmax(0,1fr)); }
  .publication-grid { grid-template-columns:repeat(3,minmax(0,1fr)); }

  .home-card { position:relative; width:100%; min-height:310px; display:flex; flex-direction:column; gap:1.4rem; padding:1.25rem; overflow:hidden; border:1px solid var(--panel-border); border-radius:var(--r-lg); background:var(--panel-bg); box-shadow:var(--shadow-card); color:var(--text); text-decoration:none; backdrop-filter:blur(7px); transition:transform var(--t-med),border-color var(--t-med),background var(--t-med),box-shadow var(--t-med); }
  .home-card:hover,.home-card:focus-within { transform:translateY(-3px); border-color:var(--signal-border); background:color-mix(in srgb,var(--panel-bg-hover) 95%,var(--signal-soft)); box-shadow:var(--shadow-lift); }
  .card-head { min-height:4rem; display:flex; align-items:start; justify-content:space-between; gap:1rem; }
  .card-label { max-width:10rem; min-height:1.7rem; display:inline-flex; align-items:center; justify-content:center; padding:.24rem .58rem; border:1px solid var(--border); border-radius:999px; color:var(--text-3); font:650 .64rem/1 var(--font-sans); letter-spacing:.06em; text-transform:uppercase; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .card-copy { min-width:0; }
  .card-copy time,.publication-year { display:block; margin:0 0 .65rem; color:var(--text-3); font:600 .68rem/1.4 var(--font-sans); letter-spacing:.025em; }
  .home-card h3 { margin:0 0 .75rem; font:600 clamp(1.08rem,1.2vw,1.34rem)/1.2 var(--font-display); letter-spacing:-.022em; text-wrap:balance; }
  .home-card h3 a { color:inherit; text-decoration:none; }
  .home-card h3 a::after { content:''; position:absolute; inset:0; }
  .home-card p { margin:0; color:var(--text-2); font-size:.86rem; line-height:1.6; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:4; overflow:hidden; }
  .card-foot { position:relative; z-index:1; display:flex; justify-content:space-between; gap:1rem; margin-top:auto; padding-top:1rem; border-top:1px solid var(--border); color:var(--text-3); font:650 .67rem/1.4 var(--font-sans); letter-spacing:.04em; text-transform:uppercase; }
  .card-foot span:last-child { color:var(--signal); }
  .post-card .card-foot span:first-child { color:var(--post-tag); }
  .course-card { min-height:285px; }
  .publication-card { min-height:285px; }

  .home-contact { padding-block:clamp(5rem,9vw,8rem); }
  .home-contact::before { background:linear-gradient(180deg,var(--home-scrim),var(--bg) 90%); }
  .contact-frame { display:grid; grid-template-columns:1fr 1fr 1fr; gap:2rem; align-items:end; padding-top:1.5rem; border-top:1px solid var(--border-med); }
  .contact-frame h2 { margin:0; font:600 clamp(1.8rem,2.9vw,2.8rem)/1 var(--font-display); letter-spacing:-.035em; }
  .contact-frame p { margin:0; color:var(--text-2); }
  .contact-frame p:last-child { text-align:right; }

  @media (max-width:1200px) {
    .research-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .post-grid { grid-template-columns:repeat(3,minmax(0,1fr)); }
  }
  @media (max-width:900px) {
    .hero-frame { min-height:auto; padding-block:7rem 5rem; }
    .hero-copy { width:min(100%,820px); }
    .hero-identity { min-height:360px; }
    .post-grid,.publication-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
  }
  @media (max-width:640px) {
    .hero-frame { padding-block:6.5rem 3.5rem; }
    .hero-identity { min-height:340px; padding:1.6rem 1.25rem 1.8rem; border-radius:24px; }
    h1 { font-size:clamp(2.35rem,10.8vw,3.35rem); }
    .hero-bio { margin-top:1.4rem; }
    .home-section { padding-block:4rem; }
    .section-header { align-items:center; gap:1rem; }
    .section-header h2 { font-size:clamp(1.65rem,8vw,2.2rem); }
    .research-grid,.course-grid,.post-grid,.publication-grid { grid-template-columns:1fr; }
    .home-card,.course-card,.publication-card { min-height:250px; }
    .contact-frame { grid-template-columns:1fr; gap:.8rem; }
    .contact-frame p:last-child { text-align:left; }
  }
</style>
