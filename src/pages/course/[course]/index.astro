---
import Redirect from '../../../components/navigation/Redirect.astro';
import {published,url} from '../../../lib/content';
export async function getStaticPaths(){return (await published('courses')).map(c=>({params:{course:c.id},props:{to:url('courses',c.id)}}));}
const {to}=Astro.props;
---
<Redirect to={to}/>
