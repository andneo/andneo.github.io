---
import Base from '../../layouts/Base.astro';
import PublicationList from '../../components/content/PublicationList.astro';
import {published,byId} from '../../lib/content';
const pubs=(await published('publications')).sort((a,b)=>b.data.year-a.data.year||byId(a,b));
---
<Base title="Publications" description="Publication records and related research materials."><div class="container page"><p class="eyebrow">Scholarly record</p><h1>Publications</h1><p><a href="/research/">Explore research projects</a> · <a href="/publications.bib" download>Download BibTeX</a></p><PublicationList publications={pubs}/></div></Base>
