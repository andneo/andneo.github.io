---
import Base from '../../layouts/Base.astro';
import ResearchThemeCard from '../../components/ResearchThemeCard.astro';
import {published,byId} from '../../lib/content';
const projects=(await published('project')).sort((a,b)=>a.data.order-b.data.order||byId(a,b));
const publications=await published('publications');
const publicationById=new Map(publications.map(pub=>[pub.id,pub]));
const publicationsFor=(project:typeof projects[number])=>project.data.publications.map(id=>publicationById.get(id)).filter((pub):pub is NonNullable<typeof pub>=>Boolean(pub));
---
<Base title="Research" description="Research themes spanning network topology, inverse design, disordered matter and biological self-assembly.">
  <div class="container page research-page">
    <header class="research-page-heading">
      <p class="eyebrow">Research</p>
      <h1>Understanding and designing complex matter.</h1>
      <p>I use statistical mechanics, topology and computation as a common language for connecting microscopic interactions to collective organisation — from network liquids and glasses to programmable materials and biological assembly.</p>
    </header>
    <div class="research-page-grid">{projects.map(project=><ResearchThemeCard project={project} publications={publicationsFor(project)} publicationLimit={4}/>)}</div>
  </div>
</Base>
<style>
  .research-page{padding-top:clamp(7.5rem,12vw,10rem)}.research-page-heading{max-width:960px;margin-bottom:clamp(2.5rem,5vw,4.5rem)}
  .research-page-heading h1{max-width:18ch;margin:.5rem 0 1.1rem;font:600 clamp(2.4rem,4.5vw,4.4rem)/1 var(--font-display);letter-spacing:-.05em}
  .research-page-heading>p:last-child{max-width:78ch;margin:0;color:var(--text-2);font-size:clamp(1rem,.97rem + .18vw,1.1rem);line-height:1.72}
  .research-page-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(.95rem,1.7vw,1.4rem)}
  @media(max-width:760px){.research-page-grid{grid-template-columns:1fr}}
</style>
