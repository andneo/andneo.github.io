---
import site from '../data/site.json';
---
<scientific-hero data-renderer={site.HERO.renderer} data-enabled={String(site.HERO.enabled)}>
 <div class="hero-surface">
  <svg class="hero-poster" viewBox="0 0 600 400" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1">{Array.from({length:7},(_,row)=>Array.from({length:9},(_,col)=><circle cx={45+col*64+(row%2)*20} cy={25+row*57} r={10+(row+col)%4*2}/>))}</g></svg>
  <canvas aria-hidden="true" hidden></canvas>
 </div>
 <div class="hero-controls"><span>Particle animation</span><button type="button" hidden>Pause animation</button><span class="hero-status" role="status"></span></div>
</scientific-hero>
<script>
 import '../interactive/hero/controller';
</script>
<style>
 scientific-hero{display:block;min-width:0}.hero-surface{position:relative;aspect-ratio:3/2;overflow:hidden;border:1px solid var(--border);background:var(--bg-off);border-radius:var(--r-lg)}.hero-poster,canvas{position:absolute;inset:0;width:100%;height:100%;display:block}.hero-poster{color:var(--accent);opacity:.5}.hero-controls{display:flex;flex-wrap:wrap;align-items:center;gap:1rem;min-height:3.5rem;font:.75rem var(--font-mono);color:var(--text-3)}button{font:inherit;background:transparent;color:var(--accent);border:1px solid var(--border-med);padding:.4rem .65rem;margin-left:auto}
</style>
