---
interface Props { kind: 'topology'|'design'|'photonics'|'biology'; }
const {kind}=Astro.props;
---
<svg class="research-glyph" viewBox="0 0 240 112" aria-hidden="true">
  {kind==='topology' && <>
    <path class="g-line soft" d="M24 66C49 21 91 18 112 53s55 38 91-4"/>
    <path class="g-line coral" d="M31 83C58 47 90 47 112 73s57 24 96-15"/>
    <circle class="g-node" cx="49" cy="45" r="4"/><circle class="g-node coral-fill" cx="112" cy="53" r="5"/><circle class="g-node" cx="174" cy="68" r="4"/>
    <path class="g-dash" d="M83 26c15 10 27 27 28 47m22-48c-14 12-21 28-20 47"/>
  </>}
  {kind==='design' && <>
    <path class="g-line soft" d="M31 78 73 36l45 30 47-39 45 35M73 36l18 56m27-26 36 26m11-65 17 59M31 78l60 14 63 0 56-30"/>
    <circle class="g-node" cx="31" cy="78" r="4"/><circle class="g-node coral-fill" cx="73" cy="36" r="5"/><circle class="g-node" cx="118" cy="66" r="4"/><circle class="g-node" cx="165" cy="27" r="4"/><circle class="g-node coral-fill" cx="210" cy="62" r="5"/>
    <circle class="g-target" cx="165" cy="27" r="16"/>
  </>}
  {kind==='photonics' && <>
    <path class="g-line" d="M20 48c24-27 48-27 72 0s48 27 72 0 44-27 62-5"/>
    <path class="g-line coral" d="M20 72c25-18 49-18 73 0s49 18 73 0 43-18 60-5"/>
    <path class="g-dash" d="M24 91h192"/><circle class="g-node" cx="92" cy="48" r="4"/><circle class="g-node coral-fill" cx="164" cy="48" r="5"/>
    <path class="g-line soft" d="M55 25v68m74-68v68m73-68v68"/>
  </>}
  {kind==='biology' && <>
    <path class="g-line soft" d="m120 20 42 24 0 48-42 24-42-24V44Z"/>
    <path class="g-line" d="m120 20 0 48 42 24m-84 0 42-24 42-24M78 44l42 24 42-24"/>
    <circle class="g-node coral-fill" cx="120" cy="20" r="5"/><circle class="g-node" cx="78" cy="44" r="4"/><circle class="g-node" cx="162" cy="44" r="4"/><circle class="g-node" cx="78" cy="92" r="4"/><circle class="g-node coral-fill" cx="162" cy="92" r="5"/>
    <path class="g-dash" d="M28 61c16-18 31 18 47 0s31 18 46 0 32 18 48 0 29 17 43 2"/>
  </>}
</svg>
<style>
  .research-glyph{display:block;width:100%;height:auto;overflow:visible}
  .g-line,.g-dash,.g-target{fill:none;vector-effect:non-scaling-stroke;stroke:var(--cool);stroke-width:1.35;stroke-linecap:round;stroke-linejoin:round}
  .g-line.soft{opacity:.34}.g-line.coral{stroke:var(--signal);opacity:.78}.g-dash{stroke:var(--text-3);stroke-width:1;stroke-dasharray:4 6;opacity:.36}.g-target{stroke:var(--signal);stroke-dasharray:3 5;opacity:.5}
  .g-node{fill:var(--cool);stroke:var(--surface);stroke-width:1.4;vector-effect:non-scaling-stroke}.g-node.coral-fill{fill:var(--signal)}
</style>
