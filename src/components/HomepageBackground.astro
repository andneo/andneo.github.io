---
import site from '../data/site.json';
---
<homepage-background data-renderer={site.HERO.renderer} data-enabled={String(site.HERO.enabled)}>
  <div class="homepage-field" aria-hidden="true">
    <svg class="homepage-field__poster" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice">
      <g>
        <path d="M-70 168c154-88 278 67 420-22s269-82 421 7 273 70 480-8" />
        <path d="M-86 288c182-104 302 66 466-20s281-54 424 37 279 39 454-44" />
        <path d="M-61 415c155-91 304 55 466-12s264-47 414 42 273 28 439-52" />
        <path d="M-72 544c161-88 315 46 478-18s267-38 417 46 272 20 427-56" />
        <path d="M-54 674c155-83 304 37 472-14s272-28 423 49 261 15 406-55" />
      </g>
    </svg>
    <canvas aria-hidden="true" hidden></canvas>
  </div>
</homepage-background>
<script>
  import '../interactive/homepage/controller';
</script>
<style>
  homepage-background { display: contents; }
  .homepage-field { position:fixed; inset:0; z-index:0; overflow:hidden; pointer-events:none; background:var(--field-wash); }
  .homepage-field::after { content:''; position:absolute; inset:0; background:var(--field-vignette); pointer-events:none; }
  .homepage-field__poster,canvas { position:absolute; inset:0; display:block; width:100%; height:100%; }
  .homepage-field__poster { opacity:.42; }
  .homepage-field__poster g { fill:none; stroke:var(--field-primary); stroke-width:2; opacity:.08; }
  canvas { opacity:.94; }
  @media print { .homepage-field { display:none !important; } }
</style>
