---
import site from '../data/site.json';
const lattice = site.HERO.lattice ?? 'kagome';
---
<homepage-background
  data-renderer={site.HERO.renderer}
  data-lattice={lattice}
  data-enabled={String(site.HERO.enabled)}
>
  <div class="homepage-field" aria-hidden="true">
    <svg class="homepage-field__poster" viewBox="0 0 1200 720" preserveAspectRatio="xMidYMid slice">
      <g class="poster-network">
        <path d="M80 120 185 60l105 60v120l-105 60-105-60Zm210 0 105-60 105 60v120l-105 60-105-60Zm210 0 105-60 105 60v120l-105 60-105-60Zm210 0 105-60 105 60v120l-105 60-105-60Z" />
        <path d="M185 300 290 240l105 60v120l-105 60-105-60Zm210 0 105-60 105 60v120l-105 60-105-60Zm210 0 105-60 105 60v120l-105 60-105-60Zm210 0 105-60 105 60v120l-105 60-105-60Z" />
      </g>
    </svg>
    <canvas class="homepage-field__base" aria-hidden="true" hidden></canvas>
    <canvas class="homepage-field__dynamic" aria-hidden="true" hidden></canvas>
    <svg class="homepage-field__active" aria-hidden="true" preserveAspectRatio="none">
      <path data-active="primary-edge" class="active-edge primary" />
      <path data-active="coral-edge" class="active-edge coral" />
      <path data-active="primary-particle" class="active-dot particle primary" />
      <path data-active="coral-particle" class="active-dot particle coral" />
      <path data-active="primary-target" class="active-dot target primary" />
      <path data-active="coral-target" class="active-dot target coral" />
    </svg>
  </div>
</homepage-background>
<script>
  import '../interactive/homepage/controller';
</script>
<style>
  homepage-background { position:absolute; inset:0; z-index:1; display:block; pointer-events:none; overflow:hidden; }
  .homepage-field { position:absolute; inset:0; z-index:1; overflow:hidden; pointer-events:none; }
  .homepage-field::after { content:''; position:absolute; inset:0; z-index:4; background:var(--field-vignette); pointer-events:none; }
  .homepage-field__poster,.homepage-field__base,.homepage-field__dynamic,.homepage-field__active { position:absolute; inset:0; display:block; width:100%; height:100%; }
  .homepage-field__poster,.homepage-field__base { z-index:1; }
  .homepage-field__dynamic { z-index:2; }
  .homepage-field__active { z-index:3; overflow:visible; pointer-events:none; }
  .homepage-field__poster { opacity:.75; }
  .poster-network { fill:none; stroke:var(--field-primary); stroke-width:1; opacity:.2; }
  .homepage-field__active .active-edge { fill:none; stroke-linecap:round; stroke-linejoin:round; }
  .homepage-field__active .active-edge.primary { stroke:var(--network-primary-edge); stroke-width:1.55; }
  .homepage-field__active .active-edge.coral { stroke:var(--network-coral-edge); stroke-width:2; }
  .homepage-field__active .active-dot { stroke:none; }
  .homepage-field__active .particle.primary { fill:var(--network-primary-particle); }
  .homepage-field__active .particle.coral { fill:var(--network-coral-particle); }
  .homepage-field__active .target.primary { fill:var(--network-primary-target); }
  .homepage-field__active .target.coral { fill:var(--network-coral-target); }
  canvas { opacity:1; }
  @media print { homepage-background { display:none !important; } }
</style>
