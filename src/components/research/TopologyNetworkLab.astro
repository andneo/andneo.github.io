---
---
<section class="topology-lab" aria-labelledby="topology-lab-title">
  <div class="topology-lab__heading">
    <div>
      <p class="eyebrow">Interactive model</p>
      <h2 id="topology-lab-title">Same graph. Different embedding.</h2>
      <p>The network keeps the same connectivity while its physical embedding changes. Inspect the elementary rings, then introduce a genuine linked pair and watch the surrounding elastic network settle into a new minimum-energy geometry.</p>
    </div>
    <dl class="topology-lab__stats" aria-label="Network statistics">
      <div><dt>nodes</dt><dd data-stat-nodes>160</dd></div>
      <div><dt>edges</dt><dd data-stat-edges>320</dd></div>
      <div><dt>4-rings</dt><dd data-stat-rings>160</dd></div>
      <div><dt>linked pairs</dt><dd data-stat-entanglements>0</dd></div>
    </dl>
  </div>

  <topology-network-lab
    class="topology-lab__instrument"
    data-mode="network"
    data-periodic="xy"
    data-engine="harmonic-relaxation"
    data-renderer="fixed-camera-3d-svg"
    data-relaxed="true"
    data-draggable="false"
    data-nodes="160"
    data-edges="320"
    data-rings="160"
    data-entanglements="0"
    data-linking-number="0"
  >
    <div class="topology-lab__toolbar">
      <div class="topology-lab__modes" role="group" aria-label="Network view">
        <button type="button" data-mode-button="network" aria-pressed="true">Network</button>
        <button type="button" data-mode-button="rings" aria-pressed="false">Rings</button>
        <button type="button" data-mode-button="entangle" aria-pressed="false">Entangle</button>
        <button type="button" data-mode-button="links" aria-pressed="false">Linked rings</button>
      </div>
      <div class="topology-lab__actions">
        <button type="button" data-entangle-action>Entangle selected ring</button>
        <button type="button" data-reset-action>Reset</button>
      </div>
    </div>

    <div class="topology-lab__stage" data-stage>
      <svg
        class="topology-lab__svg"
        role="img"
        aria-label="Fixed three-dimensional view of a periodic elastic network. Click a visible ring to select it."
        preserveAspectRatio="xMidYMid slice"
      ></svg>
      <div class="topology-lab__hint" aria-hidden="true">click a ring to select it</div>
    </div>

    <div class="topology-lab__readout" aria-live="polite">
      <span data-readout-title>Periodic network</span>
      <span data-readout-copy>The simulated cell is periodic in both directions, while the camera only shows an interior window, so no network boundary is visible.</span>
    </div>
  </topology-network-lab>
</section>

<style>
  .topology-lab{margin:clamp(2rem,4vw,4rem) 0 clamp(3rem,6vw,5.5rem)}
  .topology-lab__heading{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:clamp(2rem,5vw,5rem);align-items:end;margin-bottom:1.25rem}
  .topology-lab__heading h2{margin:.4rem 0 .75rem;font:600 clamp(1.8rem,3vw,3rem)/1.03 var(--font-display);letter-spacing:-.045em}
  .topology-lab__heading>div>p:last-child{max-width:84ch;margin:0;color:var(--text-2);line-height:1.7}
  .topology-lab__stats{display:grid;grid-template-columns:repeat(2,minmax(5rem,auto));gap:.55rem 1.2rem;margin:0}
  .topology-lab__stats div{display:grid;grid-template-columns:auto auto;gap:.65rem;align-items:baseline}
  .topology-lab__stats dt{color:var(--text-3);font:400 .65rem/1.2 var(--font-sans);text-transform:lowercase}
  .topology-lab__stats dd{margin:0;color:var(--cool);font:600 .85rem/1 var(--font-sans);font-variant-numeric:tabular-nums}

  .topology-lab__instrument{display:block;overflow:hidden;border:1px solid var(--panel-border);border-radius:var(--r-lg);background:color-mix(in srgb,var(--panel-bg) 96%,var(--cool-soft));box-shadow:var(--shadow-card)}
  .topology-lab__toolbar{display:flex;justify-content:space-between;gap:1rem;align-items:center;padding:.7rem .8rem;border-bottom:1px solid var(--border);background:color-mix(in srgb,var(--surface) 90%,transparent)}
  .topology-lab__modes,.topology-lab__actions{display:flex;flex-wrap:wrap;gap:.4rem}
  .topology-lab button{min-height:2rem;padding:.38rem .68rem;border:1px solid var(--border);border-radius:999px;background:transparent;color:var(--text-2);font:500 .7rem/1 var(--font-sans);cursor:pointer;transition:background var(--t),border-color var(--t),color var(--t)}
  .topology-lab button:hover{border-color:var(--cool-border);color:var(--text)}
  .topology-lab button:focus-visible{outline:2px solid var(--signal);outline-offset:2px}
  .topology-lab [data-mode-button][aria-pressed=true]{border-color:var(--cool-border);background:var(--cool-soft);color:var(--cool)}
  .topology-lab [data-entangle-action]{border-color:var(--signal-border);color:var(--signal)}

  .topology-lab__stage{position:relative;aspect-ratio:16/7;min-height:360px;overflow:hidden;background:
    radial-gradient(ellipse at 50% 48%,color-mix(in srgb,var(--cool-soft) 56%,transparent),transparent 58%),
    linear-gradient(180deg,color-mix(in srgb,var(--surface) 82%,transparent),color-mix(in srgb,var(--bg-off) 96%,transparent));
    perspective:1000px}
  .topology-lab__stage::after{content:'';position:absolute;inset:auto 8% 2% 8%;height:20%;border-radius:50%;background:radial-gradient(ellipse,color-mix(in srgb,var(--text) 8%,transparent),transparent 70%);filter:blur(18px);pointer-events:none}
  .topology-lab__svg{position:relative;z-index:1;display:block;width:100%;height:100%;overflow:hidden;opacity:1;transform:scale(1);transition:opacity 140ms ease,transform 240ms cubic-bezier(.22,.61,.36,1)}
  .topology-lab__stage.is-switching .topology-lab__svg{opacity:.32;transform:scale(.997)}
  .topology-lab__hint{position:absolute;z-index:2;right:.8rem;bottom:.65rem;padding:.32rem .5rem;border-radius:999px;background:color-mix(in srgb,var(--surface) 76%,transparent);color:var(--text-3);font:400 .61rem/1 var(--font-sans);pointer-events:none;backdrop-filter:blur(5px)}

  .network-shadow{fill:none;stroke:color-mix(in srgb,var(--text) 28%,transparent);stroke-width:8;stroke-linecap:round;stroke-linejoin:round;opacity:.12}
  .network-tube{fill:none;stroke:color-mix(in srgb,var(--cool) 78%,var(--text));stroke-width:6.4;stroke-linecap:round;stroke-linejoin:round}
  .network-tube-highlight{fill:none;stroke:color-mix(in srgb,var(--surface) 84%,white);stroke-width:1.45;stroke-linecap:round;stroke-linejoin:round;opacity:.38;pointer-events:none}
  .network-tube--signal{stroke:var(--signal)}
  .network-tube--cool{stroke:color-mix(in srgb,var(--cool) 88%,white)}
  .network-tube--muted{opacity:.23}
  .network-tube-highlight.network-tube--muted{opacity:.08}
  .network-shadow.network-tube--muted{opacity:.035}

  .network-node-shadow{fill:color-mix(in srgb,var(--text) 34%,transparent);opacity:.16}
  .network-node{stroke:color-mix(in srgb,var(--surface) 70%,transparent);stroke-width:.7}
  .network-node--muted{opacity:.32}
  .network-node--signal{fill:url(#node-signal)}
  .network-node--cool{fill:url(#node-cool)}
  .network-node--base{fill:url(#node-base)}

  .ring-face{fill:var(--cool-soft);stroke:var(--cool-border);stroke-width:1;opacity:.10;pointer-events:none}
  .ring-face--selected{fill:var(--signal-soft);stroke:var(--signal);stroke-width:1.7;opacity:.72}
  .ring-face--linked{fill:color-mix(in srgb,var(--cool-soft) 70%,transparent);stroke:var(--cool);stroke-width:1.4;opacity:.55}
  .ring-hit{fill:transparent;stroke:none;pointer-events:all;cursor:pointer}
  .ring-hit:focus{outline:none}
  .ring-hit:focus-visible{stroke:var(--signal);stroke-width:2;fill:var(--signal-soft)}

  .topology-lab__readout{display:grid;grid-template-columns:minmax(10rem,auto) 1fr;gap:1rem;padding:.8rem 1rem;border-top:1px solid var(--border);background:color-mix(in srgb,var(--surface) 88%,transparent)}
  .topology-lab__readout [data-readout-title]{color:var(--signal);font:600 .7rem/1.35 var(--font-sans)}
  .topology-lab__readout [data-readout-copy]{color:var(--text-2);font:400 .72rem/1.45 var(--font-sans)}

  @media(max-width:900px){
    .topology-lab__heading{grid-template-columns:1fr}
    .topology-lab__stats{grid-template-columns:repeat(4,auto);justify-content:start}
    .topology-lab__stats div{display:block}.topology-lab__stats dt{display:block;margin-bottom:.2rem}
    .topology-lab__toolbar{align-items:flex-start;flex-direction:column}
  }
  @media(max-width:620px){
    .topology-lab__stage{aspect-ratio:4/3;min-height:380px}
    .topology-lab__stats{grid-template-columns:repeat(2,auto)}
    .topology-lab__readout{grid-template-columns:1fr;gap:.25rem}
    .topology-lab__hint{display:none}
  }
</style>

<script>
  type Vec3={x:number;y:number;z:number};
  type Cell={i:number;j:number};
  type LinkPair={a:Cell;b:Cell;nodeIds:Set<number>;specialEdges:Map<string,{loop:'a'|'b';quarter:number}>};

  class TopologyNetworkLab extends HTMLElement{
    private svg!:SVGSVGElement;
    private stage!:HTMLElement;
    private nx=16;
    private ny=10;
    private baseZ=.28;
    private floorZ=-.42;
    private tilt=.39;
    private nodeBase:Vec3[]=[];
    private nodePos:Vec3[]=[];
    private neighbours:number[][]=[];
    private edges:{a:number;b:number;key:string}[]=[];
    private selected:Cell={i:7,j:4};
    private hover:Cell|null=null;
    private mode='network';
    private links:LinkPair[]=[];
    private ro?:ResizeObserver;
    private io?:IntersectionObserver;
    private mo?:MutationObserver;
    private visible=true;
    private width=1200;
    private height=520;
    private scale=100;

    connectedCallback(){
      this.svg=this.querySelector('svg')!;
      this.stage=this.querySelector('[data-stage]')!;
      this.buildGraph();
      this.relax();
      this.bind();
      this.ro=new ResizeObserver(entries=>{
        const box=entries[0]?.contentRect;
        if(box){this.width=Math.max(1,box.width);this.height=Math.max(1,box.height);this.render();}
      });
      this.ro.observe(this.stage);
      this.io=new IntersectionObserver(entries=>{this.visible=entries[0]?.isIntersecting??true;if(this.visible)this.render();});
      this.io.observe(this);
      this.mo=new MutationObserver(()=>this.render());
      this.mo.observe(document.documentElement,{attributes:true,attributeFilter:['data-theme']});
      this.render();
      this.updateReadout();
    }

    disconnectedCallback(){this.ro?.disconnect();this.io?.disconnect();this.mo?.disconnect();}

    private nodeId(i:number,j:number){return ((j%this.ny+this.ny)%this.ny)*this.nx+((i%this.nx+this.nx)%this.nx);}
    private edgeKey(a:number,b:number){return a<b?`${a}-${b}`:`${b}-${a}`;}
    private cellKey(c:Cell){return `${c.i}-${c.j}`;}

    private buildGraph(){
      this.nodeBase=[];this.nodePos=[];this.neighbours=Array.from({length:this.nx*this.ny},()=>[]);this.edges=[];
      const cx=(this.nx-1)/2,cy=(this.ny-1)/2;
      for(let j=0;j<this.ny;j++)for(let i=0;i<this.nx;i++){
        const p={x:i-cx,y:j-cy,z:this.baseZ};this.nodeBase.push(p);this.nodePos.push({...p});
      }
      for(let j=0;j<this.ny;j++)for(let i=0;i<this.nx;i++){
        const a=this.nodeId(i,j),right=this.nodeId(i+1,j),up=this.nodeId(i,j+1);
        this.addGraphEdge(a,right);this.addGraphEdge(a,up);
      }
    }

    private addGraphEdge(a:number,b:number){
      const key=this.edgeKey(a,b);
      if(!this.edges.some(e=>e.key===key))this.edges.push({a,b,key});
      if(!this.neighbours[a].includes(b))this.neighbours[a].push(b);
      if(!this.neighbours[b].includes(a))this.neighbours[b].push(a);
    }

    private ringNodes(c:Cell){return[this.nodeId(c.i,c.j),this.nodeId(c.i+1,c.j),this.nodeId(c.i+1,c.j+1),this.nodeId(c.i,c.j+1)];}
    private ringEdges(c:Cell){
      const n=this.ringNodes(c);return[
        this.edgeKey(n[0],n[1]),this.edgeKey(n[1],n[2]),this.edgeKey(n[2],n[3]),this.edgeKey(n[3],n[0])
      ];
    }

    private bind(){
      this.querySelectorAll<HTMLButtonElement>('[data-mode-button]').forEach(button=>button.addEventListener('click',()=>{
        this.mode=button.dataset.modeButton||'network';this.syncModeButtons();this.updateReadout();this.render();
      }));
      this.querySelector<HTMLButtonElement>('[data-entangle-action]')?.addEventListener('click',()=>this.entangleSelected());
      this.querySelector<HTMLButtonElement>('[data-reset-action]')?.addEventListener('click',()=>this.transition(()=>{this.links=[];this.relax();this.syncData();this.updateReadout('Periodic network','The same periodic graph is restored to its unlinked minimum-energy embedding.');}));
      this.svg.addEventListener('pointerover',e=>{
        const target=(e.target as Element).closest<SVGElement>('[data-ring]');
        if(!target)return;
        this.hover={i:Number(target.dataset.i),j:Number(target.dataset.j)};this.render();
      });
      this.svg.addEventListener('pointerout',e=>{
        const target=(e.target as Element).closest<SVGElement>('[data-ring]');
        if(!target)return;
        this.hover=null;this.render();
      });
      this.svg.addEventListener('click',e=>{
        const target=(e.target as Element).closest<SVGElement>('[data-ring]');
        if(!target)return;
        this.selected={i:Number(target.dataset.i),j:Number(target.dataset.j)};
        if(this.mode==='network')this.mode='rings';
        this.syncModeButtons();this.updateReadout();this.render();
      });
      this.svg.addEventListener('keydown',e=>{
        const target=(e.target as Element).closest<SVGElement>('[data-ring]');
        if(!target||!(e instanceof KeyboardEvent))return;
        if(e.key==='Enter'||e.key===' '){
          e.preventDefault();this.selected={i:Number(target.dataset.i),j:Number(target.dataset.j)};this.mode='rings';this.syncModeButtons();this.updateReadout();this.render();
        }
      });
    }

    private syncModeButtons(){
      this.dataset.mode=this.mode;
      this.querySelectorAll<HTMLButtonElement>('[data-mode-button]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.modeButton===this.mode)));
    }

    private transition(change:()=>void){
      this.stage.classList.add('is-switching');
      window.setTimeout(()=>{
        change();this.render();
        requestAnimationFrame(()=>this.stage.classList.remove('is-switching'));
      },110);
    }

    private entangleSelected(){
      if(this.links.some(link=>this.cellKey(link.a)===this.cellKey(this.selected)||this.cellKey(link.b)===this.cellKey(this.selected))){
        this.updateReadout('Already linked','This ring already belongs to a linked pair. Select another visible ring to create a separate entanglement.');
        return;
      }
      const partner=this.partnerFor(this.selected);
      const ids=new Set([...this.ringNodes(this.selected),...this.ringNodes(partner)]);
      if(this.links.some(link=>[...ids].some(id=>link.nodeIds.has(id)))){
        this.updateReadout('Choose another ring','That local region already participates in an entanglement. Select a ring further away.');
        return;
      }
      this.transition(()=>{
        this.links.push(this.makeLinkPair(this.selected,partner));
        this.mode='links';this.syncModeButtons();this.relax();this.syncData();
        this.updateReadout('A genuine linked pair','Two disjoint four-member cycles now form a Hopf-link-like embedding. Their graph connectivity is unchanged, but their Gauss linking number is one.');
      });
    }

    private partnerFor(c:Cell):Cell{
      const right={i:c.i+2,j:c.j};
      return right.i<=this.nx-3?right:{i:c.i-2,j:c.j};
    }

    private makeLinkPair(a:Cell,b:Cell):LinkPair{
      const nodeIds=new Set([...this.ringNodes(a),...this.ringNodes(b)]);
      const specialEdges=new Map<string,{loop:'a'|'b';quarter:number}>();
      this.ringEdges(a).forEach((key,quarter)=>specialEdges.set(key,{loop:'a',quarter}));
      this.ringEdges(b).forEach((key,quarter)=>specialEdges.set(key,{loop:'b',quarter}));
      return{a,b,nodeIds,specialEdges};
    }

    private hopfGeometry(link:LinkPair){
      const aCenter=this.cellCenterBase(link.a),bCenter=this.cellCenterBase(link.b);
      const mid={x:(aCenter.x+bCenter.x)/2,y:(aCenter.y+bCenter.y)/2,z:.62};
      const radius=.84;
      const centerA={x:mid.x-.30,y:mid.y,z:mid.z};
      const centerB={x:mid.x+.34,y:mid.y,z:mid.z};
      const pointA=(t:number):Vec3=>({x:centerA.x+radius*Math.cos(t),y:centerA.y+radius*Math.sin(t),z:centerA.z});
      const pointB=(t:number):Vec3=>({x:centerB.x+radius*Math.cos(t),y:centerB.y,z:centerB.z+radius*Math.sin(t)});
      return{radius,centerA,centerB,pointA,pointB};
    }

    private cellCenterBase(c:Cell){
      const nodes=this.ringNodes(c).map(id=>this.nodeBase[id]);
      return nodes.reduce((p,q)=>({x:p.x+q.x/4,y:p.y+q.y/4,z:p.z+q.z/4}),{x:0,y:0,z:0});
    }

    private pinnedPositions(){
      const pins=new Map<number,Vec3>();
      for(const link of this.links){
        const g=this.hopfGeometry(link);
        const angles=[-3*Math.PI/4,-Math.PI/4,Math.PI/4,3*Math.PI/4];
        this.ringNodes(link.a).forEach((id,k)=>pins.set(id,g.pointA(angles[k])));
        this.ringNodes(link.b).forEach((id,k)=>pins.set(id,g.pointB(angles[k])));
      }
      return pins;
    }

    private relax(){
      const pins=this.pinnedPositions();
      const disp=this.nodeBase.map((base,id)=>{
        const pin=pins.get(id);return pin?{x:pin.x-base.x,y:pin.y-base.y,z:pin.z-base.z}:{x:0,y:0,z:0};
      });
      const lambda=.42;
      for(let iter=0;iter<115;iter++){
        const next=disp.map(v=>({...v}));
        for(let id=0;id<disp.length;id++){
          if(pins.has(id))continue;
          let x=0,y=0,z=0;
          for(const n of this.neighbours[id]){x+=disp[n].x;y+=disp[n].y;z+=disp[n].z;}
          const denom=this.neighbours[id].length+lambda;
          next[id]={x:x/denom,y:y/denom,z:z/denom};
        }
        for(let id=0;id<disp.length;id++)disp[id]=next[id];
      }
      this.nodePos=this.nodeBase.map((base,id)=>({x:base.x+disp[id].x,y:base.y+disp[id].y,z:base.z+disp[id].z}));
      for(const [id,p] of pins)this.nodePos[id]={...p};
      this.dataset.relaxed='true';
    }

    private syncData(){
      this.dataset.entanglements=String(this.links.length);
      this.dataset.linkingNumber=this.links.length?'1':'0';
      const stat=this.closest('.topology-lab')?.querySelector('[data-stat-entanglements]');
      if(stat)stat.textContent=String(this.links.length);
    }

    private projection(){
      const visibleW=this.width<700?8.1:10.9;
      const visibleH=this.width<700?7.0:5.85;
      this.scale=Math.min(this.width/visibleW,this.height/visibleH);
      const ct=Math.cos(this.tilt),st=Math.sin(this.tilt);
      return(p:Vec3)=>{
        const sy=p.y*ct-p.z*st;
        const depth=p.y*st+p.z*ct;
        return{x:this.width/2+p.x*this.scale,y:this.height/2-sy*this.scale,depth};
      };
    }

    private edgeCurve(edge:{a:number;b:number;key:string},linkInfo?:{loop:'a'|'b';quarter:number},link?:LinkPair):Vec3[]{
      if(linkInfo&&link){
        const g=this.hopfGeometry(link);
        const start=-3*Math.PI/4+linkInfo.quarter*Math.PI/2;
        const point=linkInfo.loop==='a'?g.pointA:g.pointB;
        return Array.from({length:13},(_,k)=>point(start+(Math.PI/2)*(k/12)));
      }
      let a=this.nodePos[edge.a],b=this.nodePos[edge.b];
      const baseA=this.nodeBase[edge.a],baseB=this.nodeBase[edge.b];
      let dxBase=baseB.x-baseA.x,dyBase=baseB.y-baseA.y;
      let bx=b.x,by=b.y,bz=b.z;
      if(Math.abs(dxBase)>1.1){bx+=dxBase>0?-this.nx:this.nx;dxBase=bx-a.x;}
      if(Math.abs(dyBase)>1.1){by+=dyBase>0?-this.ny:this.ny;dyBase=by-a.y;}
      const dx=bx-a.x,dy=by-a.y,len=Math.max(.001,Math.hypot(dx,dy));
      const nx=-dy/len,ny=dx/len;
      const h=this.hash(edge.a,edge.b);
      const bow=(h-.5)*.07;
      const lift=.028+(h*.018);
      return Array.from({length:11},(_,k)=>{
        const t=k/10,s=Math.sin(Math.PI*t);
        return{x:a.x+dx*t+nx*bow*s,y:a.y+dy*t+ny*bow*s,z:a.z+(bz-a.z)*t+lift*s};
      });
    }

    private hash(a:number,b:number){const x=Math.sin(a*127.1+b*311.7)*43758.5453;return x-Math.floor(x);}

    private specialFor(key:string){
      for(const link of this.links){const info=link.specialEdges.get(key);if(info)return{info,link};}
      return null;
    }

    private path(points:Vec3[],project:(p:Vec3)=>{x:number;y:number;depth:number}){
      const pts=points.map(project);
      if(pts.length<2)return'';
      if(pts.length===2)return`M${pts[0].x.toFixed(2)},${pts[0].y.toFixed(2)} L${pts[1].x.toFixed(2)},${pts[1].y.toFixed(2)}`;
      let d=`M${pts[0].x.toFixed(2)},${pts[0].y.toFixed(2)}`;
      for(let i=0;i<pts.length-1;i++){
        const p0=pts[i-1]??pts[i],p1=pts[i],p2=pts[i+1],p3=pts[i+2]??p2;
        const c1={x:p1.x+(p2.x-p0.x)/6,y:p1.y+(p2.y-p0.y)/6};
        const c2={x:p2.x-(p3.x-p1.x)/6,y:p2.y-(p3.y-p1.y)/6};
        d+=` C${c1.x.toFixed(2)},${c1.y.toFixed(2)} ${c2.x.toFixed(2)},${c2.y.toFixed(2)} ${p2.x.toFixed(2)},${p2.y.toFixed(2)}`;
      }
      return d;
    }

    private segmentCurve(points:Vec3[]){
      const out:{points:Vec3[];depth:number}[]=[];
      for(let start=0;start<points.length-1;start+=3){
        const chunk=points.slice(start,Math.min(points.length,start+4));
        if(chunk.length<2)continue;
        const depth=chunk.reduce((sum,p)=>sum+p.y*Math.sin(this.tilt)+p.z*Math.cos(this.tilt),0)/chunk.length;
        out.push({points:chunk,depth});
      }
      return out;
    }

    private ringPolygon(c:Cell,project:(p:Vec3)=>{x:number;y:number;depth:number}){
      return this.ringNodes(c).map(id=>{const q=project(this.nodePos[id]);return`${q.x.toFixed(1)},${q.y.toFixed(1)}`;}).join(' ');
    }

    private visibleCells(project:(p:Vec3)=>{x:number;y:number;depth:number}){
      const cells:Cell[]=[];
      for(let j=1;j<this.ny-2;j++)for(let i=2;i<this.nx-3;i++){
        const q=project(this.cellCenterBase({i,j}));
        if(q.x>-80&&q.x<this.width+80&&q.y>-80&&q.y<this.height+80)cells.push({i,j});
      }
      return cells;
    }

    private render(){
      if(!this.svg||!this.visible)return;
      const project=this.projection();
      this.svg.setAttribute('viewBox',`0 0 ${this.width} ${this.height}`);
      const defs=`
        <defs>
          <radialGradient id="node-base" cx="34%" cy="28%" r="72%"><stop offset="0" stop-color="color-mix(in srgb,var(--surface) 92%,white)"/><stop offset=".28" stop-color="color-mix(in srgb,var(--cool) 68%,white)"/><stop offset="1" stop-color="color-mix(in srgb,var(--cool) 72%,var(--text))"/></radialGradient>
          <radialGradient id="node-cool" cx="34%" cy="28%" r="72%"><stop offset="0" stop-color="white"/><stop offset=".3" stop-color="color-mix(in srgb,var(--cool) 60%,white)"/><stop offset="1" stop-color="var(--cool)"/></radialGradient>
          <radialGradient id="node-signal" cx="34%" cy="28%" r="72%"><stop offset="0" stop-color="white"/><stop offset=".3" stop-color="color-mix(in srgb,var(--signal) 62%,white)"/><stop offset="1" stop-color="var(--signal)"/></radialGradient>
        </defs>`;

      type RenderSeg={d:string;shadow:string;depth:number;kind:'base'|'signal'|'cool';muted:boolean};
      const segs:RenderSeg[]=[];
      for(const edge of this.edges){
        const special=this.specialFor(edge.key);
        const curve=this.edgeCurve(edge,special?.info,special?.link);
        const projected=curve.map(project);
        const xs=projected.map(q=>q.x),ys=projected.map(q=>q.y);
        if(Math.max(...xs)<-60||Math.min(...xs)>this.width+60||Math.max(...ys)<-60||Math.min(...ys)>this.height+60)continue;
        const linked=Boolean(special);
        const kind=linked?(special!.info.loop==='a'?'signal':'cool'):'base';
        const muted=this.mode!=='network'&&this.mode!=='rings'&&!linked;
        if(linked){
          for(const part of this.segmentCurve(curve)){
            const floor=part.points.map(p=>({x:p.x,y:p.y,z:this.floorZ}));
            segs.push({d:this.path(part.points,project),shadow:this.path(floor,project),depth:part.depth,kind,muted});
          }
        }else{
          const floor=curve.map(p=>({x:p.x,y:p.y,z:this.floorZ}));
          const avg=curve.reduce((s,p)=>s+p.y*Math.sin(this.tilt)+p.z*Math.cos(this.tilt),0)/curve.length;
          segs.push({d:this.path(curve,project),shadow:this.path(floor,project),depth:avg,kind,muted});
        }
      }
      segs.sort((a,b)=>a.depth-b.depth);

      const shadows=segs.map(s=>`<path class="network-shadow ${s.muted?'network-tube--muted':''}" d="${s.shadow}"/>`).join('');
      const tubes=segs.map(s=>{
        const kind=s.kind==='signal'?' network-tube--signal':s.kind==='cool'?' network-tube--cool':'';
        const muted=s.muted?' network-tube--muted':'';
        return`<path class="network-tube${kind}${muted}" d="${s.d}"/><path class="network-tube-highlight${muted}" d="${s.d}"/>`;
      }).join('');

      const linkedCells=new Set<string>();
      for(const link of this.links){linkedCells.add(this.cellKey(link.a));linkedCells.add(this.cellKey(link.b));}
      const cells=this.visibleCells(project);
      const faces=(this.mode==='rings'||this.mode==='entangle'||this.mode==='links')?cells.map(c=>{
        const key=this.cellKey(c),selected=key===this.cellKey(this.selected),linked=linkedCells.has(key),hover=this.hover&&key===this.cellKey(this.hover);
        if(this.mode==='links'&&!linked&&!selected&&!hover)return'';
        const cls=selected||hover?'ring-face ring-face--selected':linked?'ring-face ring-face--linked':'ring-face';
        return`<polygon class="${cls}" points="${this.ringPolygon(c,project)}"/>`;
      }).join(''):'';

      const linkedNodes=new Map<number,'signal'|'cool'>();
      for(const link of this.links){this.ringNodes(link.a).forEach(id=>linkedNodes.set(id,'signal'));this.ringNodes(link.b).forEach(id=>linkedNodes.set(id,'cool'));}
      const nodes=this.nodePos.map((p,id)=>({p,id,q:project(p)})).filter(({q})=>q.x>-30&&q.x<this.width+30&&q.y>-30&&q.y<this.height+30).sort((a,b)=>a.q.depth-b.q.depth);
      const nodeMarkup=nodes.map(({p,id,q})=>{
        const floor=project({x:p.x,y:p.y,z:this.floorZ});
        const linked=linkedNodes.get(id),muted=this.mode==='links'&&!linked;
        const cls=linked==='signal'?'network-node network-node--signal':linked==='cool'?'network-node network-node--cool':'network-node network-node--base';
        const radius=linked?6.7:5.1;
        return`<ellipse class="network-node-shadow ${muted?'network-node--muted':''}" cx="${floor.x.toFixed(2)}" cy="${(floor.y+2).toFixed(2)}" rx="${(radius*1.05).toFixed(1)}" ry="${(radius*.55).toFixed(1)}"/><circle class="${cls} ${muted?'network-node--muted':''}" cx="${q.x.toFixed(2)}" cy="${q.y.toFixed(2)}" r="${radius}"/>`;
      }).join('');

      const hits=cells.map(c=>`<polygon class="ring-hit" tabindex="0" role="button" aria-label="Select ring ${c.i}, ${c.j}" data-ring data-i="${c.i}" data-j="${c.j}" points="${this.ringPolygon(c,project)}"/>`).join('');

      this.svg.innerHTML=defs+`<g aria-hidden="true">${shadows}${faces}${tubes}${nodeMarkup}</g><g>${hits}</g>`;
    }

    private updateReadout(title?:string,copy?:string){
      const t=this.querySelector('[data-readout-title]'),c=this.querySelector('[data-readout-copy]');
      if(title&&copy){if(t)t.textContent=title;if(c)c.textContent=copy;return;}
      const selectedKey=this.cellKey(this.selected);
      const linked=this.links.some(link=>this.cellKey(link.a)===selectedKey||this.cellKey(link.b)===selectedKey);
      const messages:Record<string,[string,string]>={
        network:['Periodic elastic network','This is a fixed oblique view of the relaxed periodic network. The simulated boundaries lie outside the camera window, so the lattice reads as continuous.'],
        rings:['Elementary rings',`Ring (${this.selected.i}, ${this.selected.j}) is selected. Each highlighted face is a four-member cycle of the underlying graph.`],
        entangle:['Choose a ring',linked?'This ring is already part of a linked pair. Select another ring before introducing another entanglement.':'The selected ring will be paired with a disjoint neighbouring cycle. The two loops are embedded as a linked pair and the surrounding network is relaxed around them.'],
        links:['Physical entanglement',this.links.length?`${this.links.length} linked pair${this.links.length===1?'':'s'} present. Coral and blue loops are disjoint graph cycles with linking number one; unrelated structure is faded.`:'No linked rings yet. Select a ring and introduce an entanglement.'],
      };
      const [a,b]=messages[this.mode]||messages.network;if(t)t.textContent=a;if(c)c.textContent=b;
    }
  }

  if(!customElements.get('topology-network-lab'))customElements.define('topology-network-lab',TopologyNetworkLab);
</script>
