---
---
<section class="topology-lab" aria-labelledby="topology-lab-title">
  <div class="topology-lab__heading">
    <div>
      <p class="eyebrow">Interactive model</p>
      <h2 id="topology-lab-title">Same graph. Different embedding.</h2>
      <p>The network keeps the same connectivity while its physical embedding changes. Inspect the elementary rings, then introduce a linked pair and let the surrounding elastic network relax to its minimum-energy displacement field.</p>
    </div>
    <dl class="topology-lab__stats" aria-label="Network statistics">
      <div><dt>nodes</dt><dd data-stat-nodes>198</dd></div>
      <div><dt>edges</dt><dd data-stat-edges>396</dd></div>
      <div><dt>visible rings</dt><dd data-stat-rings>96</dd></div>
      <div><dt>linked pairs</dt><dd data-stat-entanglements>0</dd></div>
    </dl>
  </div>

  <topology-network-lab
    class="topology-lab__instrument"
    data-mode="network"
    data-periodic="xy"
    data-engine="harmonic-elastic-relaxation"
    data-renderer="fixed-camera-layered-svg"
    data-relaxed="true"
    data-draggable="false"
    data-nodes="198"
    data-edges="396"
    data-rings="96"
    data-entanglements="0"
    data-linking-number="0"\n    data-link-model="hopf"
  >
    <div class="topology-lab__toolbar">
      <div class="topology-lab__modes" role="group" aria-label="Network view">
        <button type="button" data-mode-button="network" aria-pressed="true">Network</button>
        <button type="button" data-mode-button="rings" aria-pressed="false">Rings</button>
        <button type="button" data-mode-button="entangle" aria-pressed="false">Entangle</button>
        <button type="button" data-mode-button="links" aria-pressed="false">Linked rings</button>
      </div>
      <div class="topology-lab__actions">
        <button type="button" data-entangle-action>Entangle selected ring</button>
        <button type="button" data-reset-action>Reset</button>
      </div>
    </div>

    <div class="topology-lab__stage" data-stage>
      <svg
        class="topology-lab__svg"
        role="img"
        aria-label="Fixed oblique view of a relaxed periodic elastic network. Click a visible ring to select it."
        preserveAspectRatio="xMidYMid slice"
      ></svg>
      <div class="topology-lab__hint" aria-hidden="true">click a ring to select it</div>
    </div>

    <div class="topology-lab__readout" aria-live="polite">
      <span data-readout-title>Periodic elastic network</span>
      <span data-readout-copy>The simulated graph is periodic in both directions. Only an interior window is rendered, so no network boundary appears in the view.</span>
    </div>
  </topology-network-lab>
</section>

<style>
  .topology-lab{margin:clamp(2rem,4vw,4rem) 0 clamp(3rem,6vw,5.5rem)}
  .topology-lab__heading{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:clamp(2rem,5vw,5rem);align-items:end;margin-bottom:1.25rem}
  .topology-lab__heading h2{margin:.4rem 0 .75rem;font:600 clamp(1.8rem,3vw,3rem)/1.03 var(--font-display);letter-spacing:-.045em}
  .topology-lab__heading>div>p:last-child{max-width:86ch;margin:0;color:var(--text-2);line-height:1.7}
  .topology-lab__stats{display:grid;grid-template-columns:repeat(2,minmax(5rem,auto));gap:.55rem 1.2rem;margin:0}
  .topology-lab__stats div{display:grid;grid-template-columns:auto auto;gap:.65rem;align-items:baseline}
  .topology-lab__stats dt{color:var(--text-3);font:400 .65rem/1.2 var(--font-sans);text-transform:lowercase}
  .topology-lab__stats dd{margin:0;color:var(--cool);font:600 .85rem/1 var(--font-sans);font-variant-numeric:tabular-nums}

  .topology-lab__instrument{display:block;overflow:hidden;border:1px solid var(--panel-border);border-radius:var(--r-lg);background:var(--panel-bg);box-shadow:var(--shadow-card)}
  .topology-lab__toolbar{display:flex;justify-content:space-between;gap:1rem;align-items:center;padding:.7rem .8rem;border-bottom:1px solid var(--border);background:var(--surface)}
  .topology-lab__modes,.topology-lab__actions{display:flex;flex-wrap:wrap;gap:.4rem}
  .topology-lab button{min-height:2rem;padding:.38rem .68rem;border:1px solid var(--border);border-radius:999px;background:transparent;color:var(--text-2);font:500 .7rem/1 var(--font-sans);cursor:pointer;transition:background var(--t),border-color var(--t),color var(--t)}
  .topology-lab button:hover{border-color:var(--cool-border);color:var(--text)}
  .topology-lab button:focus-visible{outline:2px solid var(--signal);outline-offset:2px}
  .topology-lab [data-mode-button][aria-pressed=true]{border-color:var(--cool-border);background:var(--cool-soft);color:var(--cool)}
  .topology-lab [data-entangle-action]{border-color:var(--signal-border);color:var(--signal)}

  .topology-lab__stage{
    position:relative;
    aspect-ratio:16/7;
    min-height:360px;
    overflow:hidden;
    background:
      radial-gradient(ellipse at 50% 44%,var(--surface) 0%,var(--bg-off) 72%);
  }
  .topology-lab__stage::after{
    content:'';
    position:absolute;
    inset:auto 7% 1.5% 7%;
    height:22%;
    border-radius:50%;
    background:radial-gradient(ellipse,rgba(0,0,0,.10),transparent 72%);
    filter:blur(22px);
    pointer-events:none;
  }
  :root[data-theme=dark] .topology-lab__stage::after{background:radial-gradient(ellipse,rgba(0,0,0,.34),transparent 72%)}
  .topology-lab__svg{position:relative;z-index:1;display:block;width:100%;height:100%;overflow:hidden;transition:opacity 150ms ease,transform 220ms cubic-bezier(.22,.61,.36,1)}
  .topology-lab__stage.is-switching .topology-lab__svg{opacity:.38;transform:scale(.998)}
  .topology-lab__hint{position:absolute;z-index:2;right:.8rem;bottom:.65rem;padding:.32rem .5rem;border-radius:999px;background:var(--control-bg);color:var(--text-3);font:400 .61rem/1 var(--font-sans);pointer-events:none;backdrop-filter:blur(5px)}

  .network-shadow{fill:none;stroke:rgba(0,0,0,.18);stroke-width:9;stroke-linecap:round;stroke-linejoin:round;filter:blur(.8px)}
  :root[data-theme=dark] .network-shadow{stroke:rgba(0,0,0,.48)}
  .network-tube{fill:none;stroke:var(--cool);stroke-width:6.6;stroke-linecap:round;stroke-linejoin:round}
  .network-tube-highlight{fill:none;stroke:rgba(255,255,255,.46);stroke-width:1.25;stroke-linecap:round;stroke-linejoin:round;pointer-events:none}
  :root[data-theme=dark] .network-tube-highlight{stroke:rgba(255,255,255,.28)}
  .network-tube--signal{stroke:var(--signal)}
  .network-tube--cool{stroke:var(--cool)}
  .network-tube--muted{opacity:.18}
  .network-tube-highlight.network-tube--muted{opacity:.05}
  .network-shadow.network-tube--muted{opacity:.025}

  .network-node-shadow{fill:rgba(0,0,0,.20);filter:blur(.8px)}
  :root[data-theme=dark] .network-node-shadow{fill:rgba(0,0,0,.50)}
  .network-node-body{stroke:var(--surface);stroke-width:.75}
  .network-node-base{fill:var(--cool)}
  .network-node-signal{fill:var(--signal)}
  .network-node-cool{fill:var(--cool)}
  .network-node-highlight{fill:rgba(255,255,255,.72);pointer-events:none}
  :root[data-theme=dark] .network-node-highlight{fill:rgba(255,255,255,.50)}
  .network-node-muted{opacity:.24}

  .ring-face{fill:var(--cool-soft);stroke:var(--cool-border);stroke-width:1;opacity:.12;pointer-events:none}
  .ring-face--selected{fill:var(--signal-soft);stroke:var(--signal);stroke-width:1.8;opacity:.78}
  .ring-face--linked{fill:var(--cool-soft);stroke:var(--cool);stroke-width:1.45;opacity:.60}
  .ring-hit{fill:transparent;stroke:none;pointer-events:all;cursor:pointer}
  .ring-hit:focus{outline:none}
  .ring-hit:focus-visible{stroke:var(--signal);stroke-width:2;fill:var(--signal-soft)}

  .topology-lab__readout{display:grid;grid-template-columns:minmax(10rem,auto) 1fr;gap:1rem;padding:.8rem 1rem;border-top:1px solid var(--border);background:var(--surface)}
  .topology-lab__readout [data-readout-title]{color:var(--signal);font:600 .7rem/1.35 var(--font-sans)}
  .topology-lab__readout [data-readout-copy]{color:var(--text-2);font:400 .72rem/1.45 var(--font-sans)}

  @media(max-width:900px){
    .topology-lab__heading{grid-template-columns:1fr}
    .topology-lab__stats{grid-template-columns:repeat(4,auto);justify-content:start}
    .topology-lab__stats div{display:block}.topology-lab__stats dt{display:block;margin-bottom:.2rem}
    .topology-lab__toolbar{align-items:flex-start;flex-direction:column}
  }
  @media(max-width:620px){
    .topology-lab__stage{aspect-ratio:4/3;min-height:380px}
    .topology-lab__stats{grid-template-columns:repeat(2,auto)}
    .topology-lab__readout{grid-template-columns:1fr;gap:.25rem}
    .topology-lab__hint{display:none}
  }
</style>

<script>
  type Vec3={x:number;y:number;z:number};
  type Cell={i:number;j:number};
  type Edge={a:number;b:number;key:string};
  type LinkPair={a:Cell;b:Cell;nodeIds:Set<number>;specialEdges:Map<string,{loop:'a'|'b';quarter:number}>};

  class TopologyNetworkLab extends HTMLElement{
    private svg!:SVGSVGElement;
    private stage!:HTMLElement;
    private nx=18;
    private ny=11;
    private baseZ=.18;
    private floorZ=-.52;
    private tilt=.43;
    private nodeBase:Vec3[]=[];
    private nodePos:Vec3[]=[];
    private neighbours:number[][]=[];
    private edges:Edge[]=[];
    private selected:Cell={i:7,j:4};
    private hover:Cell|null=null;
    private mode='network';
    private links:LinkPair[]=[];
    private ro?:ResizeObserver;
    private io?:IntersectionObserver;
    private mo?:MutationObserver;
    private visible=true;
    private width=1200;
    private height=520;
    private scale=100;
    private residual=0;

    connectedCallback(){
      this.svg=this.querySelector('svg')!;
      this.stage=this.querySelector('[data-stage]')!;
      this.buildGraph();
      this.relax();
      this.bind();

      this.ro=new ResizeObserver(entries=>{
        const box=entries[0]?.contentRect;
        if(box){this.width=Math.max(1,box.width);this.height=Math.max(1,box.height);this.render();}
      });
      this.ro.observe(this.stage);

      this.io=new IntersectionObserver(entries=>{
        this.visible=entries[0]?.isIntersecting??true;
        if(this.visible)this.render();
      });
      this.io.observe(this);

      this.mo=new MutationObserver(()=>this.render());
      this.mo.observe(document.documentElement,{attributes:true,attributeFilter:['data-theme']});

      this.render();
      this.updateReadout();
    }

    disconnectedCallback(){this.ro?.disconnect();this.io?.disconnect();this.mo?.disconnect();}

    private nodeId(i:number,j:number){
      return ((j%this.ny+this.ny)%this.ny)*this.nx+((i%this.nx+this.nx)%this.nx);
    }

    private edgeKey(a:number,b:number){return a<b?`${a}-${b}`:`${b}-${a}`;}
    private cellKey(c:Cell){return `${c.i}-${c.j}`;}

    private buildGraph(){
      this.nodeBase=[];
      this.nodePos=[];
      this.neighbours=Array.from({length:this.nx*this.ny},()=>[]);
      this.edges=[];

      const cx=(this.nx-1)/2;
      const cy=(this.ny-1)/2;
      for(let j=0;j<this.ny;j++){
        for(let i=0;i<this.nx;i++){
          const p={x:i-cx,y:j-cy,z:this.baseZ};
          this.nodeBase.push(p);
          this.nodePos.push({...p});
        }
      }

      for(let j=0;j<this.ny;j++){
        for(let i=0;i<this.nx;i++){
          const a=this.nodeId(i,j);
          this.addGraphEdge(a,this.nodeId(i+1,j));
          this.addGraphEdge(a,this.nodeId(i,j+1));
        }
      }
    }

    private addGraphEdge(a:number,b:number){
      const key=this.edgeKey(a,b);
      if(!this.edges.some(e=>e.key===key))this.edges.push({a,b,key});
      if(!this.neighbours[a].includes(b))this.neighbours[a].push(b);
      if(!this.neighbours[b].includes(a))this.neighbours[b].push(a);
    }

    private ringNodes(c:Cell){
      return[
        this.nodeId(c.i,c.j),
        this.nodeId(c.i+1,c.j),
        this.nodeId(c.i+1,c.j+1),
        this.nodeId(c.i,c.j+1),
      ];
    }

    private ringEdges(c:Cell){
      const n=this.ringNodes(c);
      return[
        this.edgeKey(n[0],n[1]),
        this.edgeKey(n[1],n[2]),
        this.edgeKey(n[2],n[3]),
        this.edgeKey(n[3],n[0]),
      ];
    }

    private bind(){
      this.querySelectorAll<HTMLButtonElement>('[data-mode-button]').forEach(button=>{
        button.addEventListener('click',()=>{
          this.mode=button.dataset.modeButton||'network';
          this.syncModeButtons();
          this.updateReadout();
          this.render();
        });
      });

      this.querySelector<HTMLButtonElement>('[data-entangle-action]')?.addEventListener('click',()=>this.entangleSelected());

      this.querySelector<HTMLButtonElement>('[data-reset-action]')?.addEventListener('click',()=>{
        this.transition(()=>{
          this.links=[];
          this.relax();
          this.syncData();
          this.mode='network';
          this.syncModeButtons();
          this.updateReadout('Periodic elastic network','The unlinked minimum-energy embedding has been restored.');
        });
      });

      this.svg.addEventListener('pointerover',e=>{
        const target=(e.target as Element).closest<SVGElement>('[data-ring]');
        if(!target)return;
        this.hover={i:Number(target.dataset.i),j:Number(target.dataset.j)};
        this.render();
      });

      this.svg.addEventListener('pointerout',e=>{
        const target=(e.target as Element).closest<SVGElement>('[data-ring]');
        if(!target)return;
        this.hover=null;
        this.render();
      });

      this.svg.addEventListener('click',e=>{
        const target=(e.target as Element).closest<SVGElement>('[data-ring]');
        if(!target)return;
        this.selected={i:Number(target.dataset.i),j:Number(target.dataset.j)};
        if(this.mode==='network')this.mode='rings';
        this.syncModeButtons();
        this.updateReadout();
        this.render();
      });

      this.svg.addEventListener('keydown',e=>{
        if(!(e instanceof KeyboardEvent))return;
        const target=(e.target as Element).closest<SVGElement>('[data-ring]');
        if(!target)return;
        if(e.key==='Enter'||e.key===' '){
          e.preventDefault();
          this.selected={i:Number(target.dataset.i),j:Number(target.dataset.j)};
          this.mode='rings';
          this.syncModeButtons();
          this.updateReadout();
          this.render();
        }
      });
    }

    private syncModeButtons(){
      this.dataset.mode=this.mode;
      this.querySelectorAll<HTMLButtonElement>('[data-mode-button]').forEach(b=>{
        b.setAttribute('aria-pressed',String(b.dataset.modeButton===this.mode));
      });
    }

    private transition(change:()=>void){
      this.stage.classList.add('is-switching');
      window.setTimeout(()=>{
        change();
        this.render();
        requestAnimationFrame(()=>this.stage.classList.remove('is-switching'));
      },110);
    }

    private partnerFor(c:Cell):Cell{
      const right={i:c.i+2,j:c.j};
      return right.i<=13?right:{i:c.i-2,j:c.j};
    }

    private entangleSelected(){
      const partner=this.partnerFor(this.selected);

      const touched=new Set([...this.ringNodes(this.selected),...this.ringNodes(partner)]);
      if(this.links.some(link=>[...touched].some(id=>link.nodeIds.has(id)))){
        this.updateReadout('Choose another ring','That local region already participates in a linked pair. Select a ring farther away.');
        return;
      }

      this.transition(()=>{
        const nodeIds=new Set([...this.ringNodes(this.selected),...this.ringNodes(partner)]);
        const specialEdges=new Map<string,{loop:'a'|'b';quarter:number}>();
        this.ringEdges(this.selected).forEach((key,quarter)=>specialEdges.set(key,{loop:'a',quarter}));
        this.ringEdges(partner).forEach((key,quarter)=>specialEdges.set(key,{loop:'b',quarter}));
        this.links.push({a:{...this.selected},b:partner,nodeIds,specialEdges});
        this.mode='links';
        this.syncModeButtons();
        this.relax();
        this.syncData();
        this.updateReadout(
          'A linked pair',
          'The coral and blue cycles are disjoint closed curves with linking number one. Their graph connectivity is unchanged; only the three-dimensional embedding has changed.'
        );
      });
    }

    private cellCenter(c:Cell){
      const ids=this.ringNodes(c);
      const sum=ids.reduce((acc,id)=>{
        const p=this.nodeBase[id];
        return{x:acc.x+p.x,y:acc.y+p.y,z:acc.z+p.z};
      },{x:0,y:0,z:0});
      return{x:sum.x/4,y:sum.y/4,z:sum.z/4};
    }

    private hopfGeometry(link:LinkPair){
      const ca=this.cellCenter(link.a);
      const cb=this.cellCenter(link.b);
      const mid={x:(ca.x+cb.x)/2,y:(ca.y+cb.y)/2,z:.62};
      const r=.79;
      const centerA={x:mid.x-.28,y:mid.y,z:mid.z};
      const centerB={x:mid.x+.33,y:mid.y,z:mid.z};
      const pointA=(t:number):Vec3=>({
        x:centerA.x+r*Math.cos(t),
        y:centerA.y+r*Math.sin(t),
        z:centerA.z,
      });
      const pointB=(t:number):Vec3=>({
        x:centerB.x+r*Math.cos(t),
        y:centerB.y,
        z:centerB.z+r*Math.sin(t),
      });
      return{pointA,pointB};
    }

    private pinnedPositions(){
      const pins=new Map<number,Vec3>();
      const angles=[-3*Math.PI/4,-Math.PI/4,Math.PI/4,3*Math.PI/4];

      for(const link of this.links){
        const g=this.hopfGeometry(link);
        this.ringNodes(link.a).forEach((id,k)=>pins.set(id,g.pointA(angles[k])));
        this.ringNodes(link.b).forEach((id,k)=>pins.set(id,g.pointB(angles[k])));
      }
      return pins;
    }

    private relax(){
      const pins=this.pinnedPositions();
      const displacement=this.nodeBase.map((base,id)=>{
        const pin=pins.get(id);
        return pin
          ?{x:pin.x-base.x,y:pin.y-base.y,z:pin.z-base.z}
          :{x:0,y:0,z:0};
      });

      const tether=.55;
      this.residual=Infinity;

      for(let iter=0;iter<360;iter++){
        const next=displacement.map(v=>({...v}));
        let residual=0;

        for(let id=0;id<displacement.length;id++){
          if(pins.has(id))continue;

          let x=0,y=0,z=0;
          for(const n of this.neighbours[id]){
            x+=displacement[n].x;
            y+=displacement[n].y;
            z+=displacement[n].z;
          }

          const denom=this.neighbours[id].length+tether;
          const candidate={x:x/denom,y:y/denom,z:z/denom};
          residual=Math.max(
            residual,
            Math.abs(candidate.x-displacement[id].x),
            Math.abs(candidate.y-displacement[id].y),
            Math.abs(candidate.z-displacement[id].z)
          );
          next[id]=candidate;
        }

        for(let id=0;id<displacement.length;id++)displacement[id]=next[id];
        this.residual=residual;
        if(residual<1e-5)break;
      }

      this.nodePos=this.nodeBase.map((base,id)=>({
        x:base.x+displacement[id].x,
        y:base.y+displacement[id].y,
        z:base.z+displacement[id].z,
      }));

      for(const [id,p] of pins)this.nodePos[id]={...p};

      this.dataset.relaxed=String(this.residual<2e-4);
      this.dataset.energyResidual=this.residual.toExponential(2);
    }

    private syncData(){
      this.dataset.entanglements=String(this.links.length);
      this.dataset.linkingNumber=this.links.length?'1':'0';
      const stat=this.closest('.topology-lab')?.querySelector('[data-stat-entanglements]');
      if(stat)stat.textContent=String(this.links.length);
    }

    private projectFactory(){
      const viewW=this.width<700?8.3:11.5;
      const viewH=this.width<700?7.2:6.0;
      this.scale=Math.min(this.width/viewW,this.height/viewH);

      const ct=Math.cos(this.tilt);
      const st=Math.sin(this.tilt);

      return(p:Vec3)=>{
        const sy=p.y*ct-p.z*st;
        const depth=p.y*st+p.z*ct;
        return{
          x:this.width/2+p.x*this.scale,
          y:this.height/2-sy*this.scale,
          depth,
        };
      };
    }

    private unwrapEdge(edge:Edge){
      const a={...this.nodePos[edge.a]};
      const b={...this.nodePos[edge.b]};
      const ba=this.nodeBase[edge.a];
      const bb=this.nodeBase[edge.b];
      const rawX=bb.x-ba.x;
      const rawY=bb.y-ba.y;

      if(Math.abs(rawX)>1.5)b.x+=rawX>0?-this.nx:this.nx;
      if(Math.abs(rawY)>1.5)b.y+=rawY>0?-this.ny:this.ny;

      return{a,b};
    }

    private ordinaryCurve(edge:Edge){
      const {a,b}=this.unwrapEdge(edge);
      const dx=b.x-a.x;
      const dy=b.y-a.y;
      const len=Math.max(.001,Math.hypot(dx,dy));
      const nx=-dy/len;
      const ny=dx/len;
      const bow=(this.hash(edge.a,edge.b)-.5)*.055;
      const lift=.020+(this.hash(edge.b,edge.a)*.014);

      return Array.from({length:9},(_,k)=>{
        const t=k/8;
        const s=Math.sin(Math.PI*t);
        return{
          x:a.x+dx*t+nx*bow*s,
          y:a.y+dy*t+ny*bow*s,
          z:a.z+(b.z-a.z)*t+lift*s,
        };
      });
    }

    private specialFor(key:string){
      for(const link of this.links){
        const info=link.specialEdges.get(key);
        if(info)return{info,link};
      }
      return null;
    }

    private specialCurve(info:{loop:'a'|'b';quarter:number},link:LinkPair){
      const g=this.hopfGeometry(link);
      const start=-3*Math.PI/4+info.quarter*Math.PI/2;
      const point=info.loop==='a'?g.pointA:g.pointB;

      return Array.from({length:17},(_,k)=>point(start+(Math.PI/2)*(k/16)));
    }

    private hash(a:number,b:number){
      const x=Math.sin(a*127.1+b*311.7)*43758.5453;
      return x-Math.floor(x);
    }

    private path(points:Vec3[],project:(p:Vec3)=>{x:number;y:number;depth:number}){
      const pts=points.map(project);
      if(pts.length<2)return'';

      let d=`M${pts[0].x.toFixed(2)},${pts[0].y.toFixed(2)}`;
      for(let i=0;i<pts.length-1;i++){
        const p0=pts[i-1]??pts[i];
        const p1=pts[i];
        const p2=pts[i+1];
        const p3=pts[i+2]??p2;
        const c1={x:p1.x+(p2.x-p0.x)/6,y:p1.y+(p2.y-p0.y)/6};
        const c2={x:p2.x-(p3.x-p1.x)/6,y:p2.y-(p3.y-p1.y)/6};
        d+=` C${c1.x.toFixed(2)},${c1.y.toFixed(2)} ${c2.x.toFixed(2)},${c2.y.toFixed(2)} ${p2.x.toFixed(2)},${p2.y.toFixed(2)}`;
      }
      return d;
    }

    private visibleNode(id:number,project:(p:Vec3)=>{x:number;y:number;depth:number}){
      const q=project(this.nodeBase[id]);
      return q.x>-120&&q.x<this.width+120&&q.y>-120&&q.y<this.height+120;
    }

    private visibleCells(project:(p:Vec3)=>{x:number;y:number;depth:number}){
      const cells:Cell[]=[];
      for(let j=1;j<=8;j++){
        for(let i=2;i<=13;i++){
          const q=project(this.cellCenter({i,j}));
          if(q.x>-50&&q.x<this.width+50&&q.y>-50&&q.y<this.height+50)cells.push({i,j});
        }
      }
      return cells;
    }

    private ringPolygon(c:Cell,project:(p:Vec3)=>{x:number;y:number;depth:number}){
      return this.ringNodes(c).map(id=>{
        const q=project(this.nodePos[id]);
        return`${q.x.toFixed(1)},${q.y.toFixed(1)}`;
      }).join(' ');
    }

    private render(){
      if(!this.svg||!this.visible)return;

      const project=this.projectFactory();
      this.svg.setAttribute('viewBox',`0 0 ${this.width} ${this.height}`);

      type Primitive=
        |{type:'tube';d:string;shadow:string;depth:number;kind:'base'|'signal'|'cool';muted:boolean}
        |{type:'node';x:number;y:number;sx:number;sy:number;depth:number;kind:'base'|'signal'|'cool';muted:boolean};

      const primitives:Primitive[]=[];
      const linkedNodes=new Map<number,'signal'|'cool'>();

      for(const link of this.links){
        this.ringNodes(link.a).forEach(id=>linkedNodes.set(id,'signal'));
        this.ringNodes(link.b).forEach(id=>linkedNodes.set(id,'cool'));
      }

      for(const edge of this.edges){
        if(!this.visibleNode(edge.a,project)&&!this.visibleNode(edge.b,project))continue;

        const special=this.specialFor(edge.key);
        const curve=special?this.specialCurve(special.info,special.link):this.ordinaryCurve(edge);
        const projected=curve.map(project);

        if(
          Math.max(...projected.map(p=>p.x))<-80||
          Math.min(...projected.map(p=>p.x))>this.width+80||
          Math.max(...projected.map(p=>p.y))<-80||
          Math.min(...projected.map(p=>p.y))>this.height+80
        )continue;

        const kind=special?(special.info.loop==='a'?'signal':'cool'):'base';
        const muted=this.mode==='links'&&!special;
        const floor=curve.map(p=>({x:p.x,y:p.y,z:this.floorZ}));
        const depth=projected.reduce((sum,p)=>sum+p.depth,0)/projected.length;

        primitives.push({
          type:'tube',
          d:this.path(curve,project),
          shadow:this.path(floor,project),
          depth,
          kind,
          muted,
        });
      }

      for(let id=0;id<this.nodePos.length;id++){
        const q=project(this.nodePos[id]);
        if(q.x<-40||q.x>this.width+40||q.y<-40||q.y>this.height+40)continue;

        const shadow=project({x:this.nodePos[id].x,y:this.nodePos[id].y,z:this.floorZ});
        const kind=linkedNodes.get(id)??'base';
        const muted=this.mode==='links'&&!linkedNodes.has(id);

        primitives.push({
          type:'node',
          x:q.x,
          y:q.y,
          sx:shadow.x,
          sy:shadow.y,
          depth:q.depth+.015,
          kind,
          muted,
        });
      }

      primitives.sort((a,b)=>a.depth-b.depth);

      const body=primitives.map(item=>{
        if(item.type==='tube'){
          const kindClass=item.kind==='signal'?' network-tube--signal':item.kind==='cool'?' network-tube--cool':'';
          const muted=item.muted?' network-tube--muted':'';
          return`
            <path class="network-shadow${muted}" d="${item.shadow}"/>
            <path class="network-tube${kindClass}${muted}" d="${item.d}"/>
            <path class="network-tube-highlight${muted}" d="${item.d}"/>
          `;
        }

        const kindClass=item.kind==='signal'?'network-node-signal':item.kind==='cool'?'network-node-cool':'network-node-base';
        const muted=item.muted?' network-node-muted':'';
        const r=item.kind==='base'?5.1:6.6;

        return`
          <ellipse class="network-node-shadow${muted}" cx="${item.sx.toFixed(2)}" cy="${(item.sy+2).toFixed(2)}" rx="${(r*1.10).toFixed(1)}" ry="${(r*.52).toFixed(1)}"/>
          <circle class="network-node-body ${kindClass}${muted}" cx="${item.x.toFixed(2)}" cy="${item.y.toFixed(2)}" r="${r}"/>
          <circle class="network-node-highlight${muted}" cx="${(item.x-r*.28).toFixed(2)}" cy="${(item.y-r*.32).toFixed(2)}" r="${(r*.25).toFixed(2)}"/>
        `;
      }).join('');

      const linkedCells=new Set<string>();
      for(const link of this.links){
        linkedCells.add(this.cellKey(link.a));
        linkedCells.add(this.cellKey(link.b));
      }

      const cells=this.visibleCells(project);

      const faces=(this.mode==='rings'||this.mode==='entangle'||this.mode==='links')
        ?cells.map(c=>{
          const key=this.cellKey(c);
          const selected=key===this.cellKey(this.selected);
          const linked=linkedCells.has(key);
          const hovered=this.hover&&key===this.cellKey(this.hover);

          if(this.mode==='links'&&!linked&&!selected&&!hovered)return'';

          const cls=selected||hovered
            ?'ring-face ring-face--selected'
            :linked
              ?'ring-face ring-face--linked'
              :'ring-face';

          return`<polygon class="${cls}" points="${this.ringPolygon(c,project)}"/>`;
        }).join('')
        :'';

      const hits=cells.map(c=>`
        <polygon
          class="ring-hit"
          tabindex="0"
          role="button"
          aria-label="Select ring ${c.i}, ${c.j}"
          data-ring
          data-i="${c.i}"
          data-j="${c.j}"
          points="${this.ringPolygon(c,project)}"
        />
      `).join('');

      this.svg.innerHTML=`
        <g aria-hidden="true">${body}</g>
        <g aria-hidden="true">${faces}</g>
        <g>${hits}</g>
      `;
    }

    private updateReadout(title?:string,copy?:string){
      const t=this.querySelector('[data-readout-title]');
      const c=this.querySelector('[data-readout-copy]');

      if(title&&copy){
        if(t)t.textContent=title;
        if(c)c.textContent=copy;
        return;
      }

      const selectedKey=this.cellKey(this.selected);
      const linked=this.links.some(link=>this.cellKey(link.a)===selectedKey||this.cellKey(link.b)===selectedKey);

      const messages:Record<string,[string,string]>={
        network:[
          'Periodic elastic network',
          'The graph is periodic, but the camera renders only an interior window. The geometry shown is the converged minimum of the harmonic displacement energy.'
        ],
        rings:[
          'Elementary rings',
          `Ring (${this.selected.i}, ${this.selected.j}) is selected. Each selectable face is a four-member cycle of the coarse network.`
        ],
        entangle:[
          'Choose a ring',
          linked
            ?'This ring already belongs to a linked pair. Select another ring before adding another entanglement.'
            :'The selected ring will be paired with a disjoint neighboring cycle. Their connectivity stays fixed while their spatial embedding becomes linked.'
        ],
        links:[
          'Physical entanglement',
          this.links.length
            ?`${this.links.length} linked pair${this.links.length===1?'':'s'} present. Coral and blue identify disjoint cycles with linking number one; unrelated structure is faded.`
            :'No linked rings yet. Select a ring and introduce an entanglement.'
        ],
      };

      const [a,b]=messages[this.mode]||messages.network;
      if(t)t.textContent=a;
      if(c)c.textContent=b;
    }
  }

  if(!customElements.get('topology-network-lab')){
    customElements.define('topology-network-lab',TopologyNetworkLab);
  }
</script>
