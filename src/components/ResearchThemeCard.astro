---
import type { CollectionEntry } from 'astro:content';
import ResearchGlyph from './ResearchGlyph.astro';
import { url } from '../lib/content';
interface Props { project:CollectionEntry<'project'>; publications:CollectionEntry<'publications'>[]; publicationLimit?:number; }
const {project,publications,publicationLimit=3}=Astro.props;
const kind=(project.data.tags[0]??'topology') as 'topology'|'design'|'glasses'|'biology';
const selected=publications.slice(0,publicationLimit);
---
<article class:list={['research-theme-card',`theme-${kind}`]}>
  <div class:list={['theme-visual',kind==='topology'&&'theme-visual-image']}>
    {kind==='topology'
      ? <img
          class="theme-image"
          src="/images/research/topology-networked-matter.webp"
          alt="Interlocked coloured rings highlighted within a disordered network"
          width="520"
          height="243"
          loading="lazy"
          decoding="async"
        />
      : <ResearchGlyph kind={kind}/>}
  </div>
  <div class="theme-body">
    <div class="theme-heading"><h3><a href={url('project',project.id)}>{project.data.title}</a></h3></div>
    {project.data.question&&<p class="theme-question">{project.data.question}</p>}
    <p class="theme-description">{project.data.description}</p>
    <ul class="theme-topics" aria-label="Topics">{project.data.topics.slice(0,4).map(topic=><li>{topic}</li>)}</ul>
  </div>
  {selected.length>0&&<div class="theme-papers"><p class="theme-papers-label">Selected papers</p><ol>{selected.map(pub=><li><a href={url('publications',pub.id)}><span class="paper-meta">{pub.data.year} · {pub.data.journal}</span><span class="paper-title">{pub.data.title}</span></a></li>)}</ol></div>}
</article>
<style>
  .research-theme-card{--theme-accent:var(--cool);--theme-structure:var(--cool);min-width:0;display:grid;grid-template-rows:auto 1fr auto;overflow:hidden;border:1px solid color-mix(in srgb,var(--panel-border) 82%,var(--theme-accent) 18%);border-radius:var(--r-lg);background:color-mix(in srgb,var(--panel-bg) 97%,var(--theme-accent) 3%);box-shadow:var(--shadow-card),inset 0 2px 0 color-mix(in srgb,var(--theme-accent) 42%,transparent);transition:transform 160ms cubic-bezier(.22,.61,.36,1),border-color 160ms ease,background 160ms ease,box-shadow 160ms ease}
  .theme-design{--theme-accent:var(--signal);--theme-structure:var(--cool)}
  .theme-glasses{--theme-accent:color-mix(in srgb,var(--signal) 48%,var(--cool));--theme-structure:color-mix(in srgb,var(--cool) 68%,var(--signal))}
  .theme-biology{--theme-accent:color-mix(in srgb,var(--cool) 72%,var(--signal));--theme-structure:color-mix(in srgb,var(--cool) 82%,var(--signal))}
  @media(hover:hover){.research-theme-card:hover{transform:translateY(-2px);border-color:color-mix(in srgb,var(--theme-accent) 62%,var(--panel-border));background:color-mix(in srgb,var(--panel-bg-hover) 94%,var(--theme-accent) 6%);box-shadow:var(--shadow-lift),inset 0 2px 0 color-mix(in srgb,var(--theme-accent) 68%,transparent)}}
  .research-theme-card:has(a:focus-visible){transform:translateY(-2px);border-color:color-mix(in srgb,var(--theme-accent) 62%,var(--panel-border));background:color-mix(in srgb,var(--panel-bg-hover) 94%,var(--theme-accent) 6%);box-shadow:var(--shadow-lift),inset 0 2px 0 color-mix(in srgb,var(--theme-accent) 68%,transparent)}
  .theme-visual{min-height:120px;display:flex;align-items:center;padding:1rem 1.2rem .7rem;border-bottom:1px solid color-mix(in srgb,var(--border) 78%,var(--theme-accent) 22%);background:radial-gradient(circle at 82% 18%,color-mix(in srgb,var(--theme-accent) 18%,transparent),transparent 43%),linear-gradient(135deg,color-mix(in srgb,var(--bg-off) 88%,var(--theme-accent) 12%),color-mix(in srgb,var(--surface) 96%,var(--theme-accent) 4%))}
  .theme-visual-image{overflow:hidden}
  .theme-image{display:block;width:100%;height:auto;aspect-ratio:240/112;object-fit:cover;object-position:center}
  .theme-body{padding:1.25rem 1.3rem 1rem}.theme-heading h3{margin:0;font:600 clamp(1.25rem,1.5vw,1.55rem)/1.14 var(--font-display);letter-spacing:-.025em}.theme-heading a{color:var(--text);text-decoration:none}.theme-heading a:hover{color:var(--theme-accent)}
  .theme-question{margin:1rem 0 .65rem;padding-left:.7rem;border-left:2px solid color-mix(in srgb,var(--theme-accent) 70%,transparent);color:var(--text);font:500 .9rem/1.5 var(--font-sans)}.theme-description{margin:0;color:var(--text-2);font-size:.86rem;line-height:1.62}
  .theme-topics{display:flex;flex-wrap:wrap;gap:0;margin:1rem 0 0;padding:0;list-style:none}.theme-topics li{display:inline-flex;align-items:center;white-space:nowrap;color:var(--text-3);font:400 .66rem/1.3 var(--font-sans);text-transform:lowercase}.theme-topics li:not(:last-child)::after{content:'·';margin-inline:.55rem;color:var(--theme-accent);opacity:.9}
  .theme-papers{margin-top:.15rem;padding:0 1.3rem 1.2rem}.theme-papers-label{margin:0 0 .3rem;color:color-mix(in srgb,var(--theme-accent) 74%,var(--text-2));font:400 .65rem/1.2 var(--font-sans);text-transform:lowercase}.theme-papers ol{margin:0;padding:0;list-style:none}.theme-papers li{border-top:1px solid color-mix(in srgb,var(--border) 84%,var(--theme-accent) 16%)}
  .theme-papers a{display:grid;gap:.18rem;padding:.72rem 0;color:var(--text);text-decoration:none}.theme-papers a:hover .paper-title{color:var(--theme-accent)}
  .paper-meta{color:color-mix(in srgb,var(--theme-accent) 68%,var(--text-3));font:400 .61rem/1.25 var(--font-sans)}.paper-title{font:500 .76rem/1.4 var(--font-sans);transition:color var(--t)}
</style>
