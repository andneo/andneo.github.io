---
interface Props { columns?: 2 | 3; }
const { columns = 2 } = Astro.props;
---
<div class="figure-grid" style={`--columns:${columns}`}><slot /></div>
<style>.figure-grid{display:grid;grid-template-columns:repeat(var(--columns),minmax(0,1fr));gap:1.5rem}@media(max-width:700px){.figure-grid{grid-template-columns:1fr}}</style>
