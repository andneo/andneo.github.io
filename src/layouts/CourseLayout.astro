---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import Toc from '../components/navigation/Toc.astro';
import Resources from '../components/content/Resources.astro';
import { courseChapters, url } from '../lib/content';
interface Props { course:CollectionEntry<'courses'>; page?:CollectionEntry<'chapters'>; headings:MarkdownHeading[]; }
const { course,page,headings }=Astro.props;
const chapters=await courseChapters(course.id);
const data=page?.data??course.data;
const index=chapters.findIndex(c=>c.id===page?.id);
const prev=index>0?chapters[index-1]:null,next=page?chapters[index+1]:chapters[0];
---
<Base title={page?`${data.title} — ${course.data.title}`:course.data.title} description={data.description}>
 <div class="course-shell container page">
  <aside class="book-nav"><details open><summary>{course.data.title}</summary><nav aria-label="Course chapters"><a href={url('courses',course.id)} aria-current={!page?'page':undefined}>Overview</a><ol>{chapters.map(ch=><li class:list={{section:ch.data.kind==='section'}}><a href={url('chapters',ch.id)} aria-current={page?.id===ch.id?'page':undefined}>{ch.data.kind==='appendix'?'Appendix · ':''}{ch.data.title}</a></li>)}</ol></nav></details></aside>
  <article class="reading-main">
   <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/courses/">Courses</a> / <a href={url('courses',course.id)}>{course.data.title}</a>{page&&<> / {page.data.title}</>}</nav>
   <h1>{data.title}</h1>{data.subtitle&&<p class="subtitle">{data.subtitle}</p>}
   {!page&&<p class="meta">{course.data.level} · {course.data.status}</p>}
   {data.objectives.length>0&&<section><h2>Learning objectives</h2><ul>{data.objectives.map(o=><li>{o}</li>)}</ul></section>}
   <Resources resources={data.resources}/>
   <div class="prose"><slot/></div>
   {!page&&<section><h2>Chapters</h2><ol>{chapters.map(ch=><li><a href={url('chapters',ch.id)}>{ch.data.title}</a></li>)}</ol></section>}
   <nav class="pagination" aria-label="Previous and next chapter">{prev?<a href={url('chapters',prev.id)}>← {prev.data.title}</a>:page?<a href={url('courses',course.id)}>← Overview</a>:<span/>}{next&&<a href={url('chapters',next.id)}>{next.data.title} →</a>}</nav>
  </article>
  <aside class="chapter-toc"><Toc headings={headings}/></aside>
 </div>
</Base>
