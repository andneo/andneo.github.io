---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import Toc from '../components/navigation/Toc.astro';
import Resources from '../components/content/Resources.astro';
import { topicsOf, topicSlug, published, url } from '../lib/content';
interface Props { post: CollectionEntry<'post'>; headings: MarkdownHeading[]; }
const { post, headings } = Astro.props;
const data=post.data;
const related=(await published('post')).filter(p=>data.related.includes(p.id));
const series=data.series?(await published('post')).filter(p=>p.data.series===data.series).sort((a,b)=>a.data.seriesOrder!-b.data.seriesOrder!):[];
const index=series.findIndex(p=>p.id===post.id);
const minutes=data.readingTime??Math.max(1,Math.ceil((post.body??'').split(/\s+/).length/200));
---
<Base title={data.title} description={data.description} type="article" image={data.image}>
 <div class="reading-shell container page">
  <aside class="reading-toc"><Toc headings={headings}/></aside>
  <article class="reading-main">
   <header><a href="/posts/">Articles</a><h1>{data.title}</h1>{data.subtitle&&<p class="subtitle">{data.subtitle}</p>}
    <p class="meta"><time datetime={data.date.toISOString()}>{data.date.toLocaleDateString('en-GB',{timeZone:'UTC',dateStyle:'long'})}</time> · approximately {minutes} min read{data.updated&&<> · Updated <time datetime={data.updated.toISOString()}>{data.updated.toISOString().slice(0,10)}</time></>}</p>
    <p>{topicsOf(post).map(t=><a class="tag" href={`/topics/${topicSlug(t)}/`}>{t}</a>)}</p>
    {data.image&&<img src={data.image} alt={data.imageAlt??''} />}
    <Resources resources={data.resources}/>
   </header>
   {data.series&&<p class="meta">Part {data.seriesOrder} of <a href={`/series/${data.series}/`}>{data.series.replaceAll('-',' ')}</a></p>}
   <div class="prose"><slot/></div>
   {series.length>0&&<nav class="pagination" aria-label="Article series">{index>0?<a href={url('post',series[index-1].id)}>← {series[index-1].data.title}</a>:<span/>}{index<series.length-1&&<a href={url('post',series[index+1].id)}>{series[index+1].data.title} →</a>}</nav>}
   {related.length>0&&<section><h2>Related articles</h2><ul>{related.map(p=><li><a href={url('post',p.id)}>{p.data.title}</a></li>)}</ul></section>}
  </article>
 </div>
</Base>
