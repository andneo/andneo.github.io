---
import { AUTHOR, SOCIAL, NAV, SITE_NAME, SITE_URL, ACCENT_HUE } from '../config';
import { validateContent } from '../lib/content';
import '../styles/global.css';
import 'katex/dist/katex.min.css';
await validateContent();
interface Props { title?: string; description?: string; noCanvas?: boolean; image?: string; type?: 'website' | 'article'; noindex?: boolean; }
const { title, description = AUTHOR.bio.replace(/<[^>]+>/g, '').slice(0,160), image, type = 'website', noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_NAME}` : `${AUTHOR.name} | ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, SITE_URL);
const active = (href: string) => !href.includes('#') && (href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(href));
---
<!doctype html>
<html lang="en" style={`--accent-hue:${ACCENT_HUE}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, SITE_URL)} />}
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try { const theme = localStorage.getItem('theme'); if (theme === 'dark' || theme === 'light') document.documentElement.dataset.theme = theme; } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">{SITE_NAME}</a>
        <nav class="site-nav" aria-label="Main navigation">
          {NAV.map(item => <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <button class="theme-button" type="button" hidden>Theme</button>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <p>© {new Date().getFullYear()} {AUTHOR.name}</p>
        <nav aria-label="Contact and profiles">
          <a href={`mailto:${AUTHOR.email}`}>Email</a>
          {SOCIAL.github && <a href={SOCIAL.github}>GitHub</a>}
          {SOCIAL.googleScholar && <a href={SOCIAL.googleScholar}>Scholar</a>}
          {SOCIAL.orcid && <a href={SOCIAL.orcid}>ORCID</a>}
        </nav>
      </div>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>('.theme-button');
      if (button) {
        button.hidden = false;
        const dark = () => document.documentElement.dataset.theme === 'dark' || (!document.documentElement.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
        const update = () => { button.textContent = dark() ? 'Light theme' : 'Dark theme'; };
        update(); matchMedia('(prefers-color-scheme: dark)').addEventListener('change',update);
        button.addEventListener('click', () => { const next = dark() ? 'light' : 'dark'; document.documentElement.dataset.theme = next; try { localStorage.setItem('theme',next); } catch {} update(); });
      }
    </script>
  </body>
</html>
