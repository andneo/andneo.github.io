---
import { AUTHOR, SOCIAL, NAV, SITE_NAME, SITE_URL } from '../config';
import { validateContent } from '../lib/content';
import '../styles/global.css';
import 'katex/dist/katex.min.css';
await validateContent();
interface Props { title?: string; description?: string; noCanvas?: boolean; image?: string; type?: 'website' | 'article'; noindex?: boolean; }
const { title, description = AUTHOR.bio.replace(/<[^>]+>/g, '').slice(0,160), image, type = 'website', noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_NAME}` : `${AUTHOR.name} | ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, SITE_URL);
const active = (href: string) => !href.includes('#') && (href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, SITE_URL)} />}
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try { const theme = localStorage.getItem('theme'); if (theme === 'dark' || theme === 'light') document.documentElement.dataset.theme = theme; } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" data-header data-shrunk="false">
      <div class="container header-inner" data-header-track>
        <a class="brand" href="/">{SITE_NAME}</a>
        <nav class="site-nav" aria-label="Main navigation" data-navbar>
          {NAV.map(item => <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <button class="theme-button" type="button" hidden aria-label="Dark theme" title="Switch to dark theme">
          <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.2 15.3A8.5 8.5 0 0 1 8.7 3.8 8.5 8.5 0 1 0 20.2 15.3Z"></path>
          </svg>
          <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true" hidden>
            <circle cx="12" cy="12" r="3.5"></circle>
            <path d="M12 2.5v2M12 19.5v2M4.5 12h-2M21.5 12h-2M5.3 5.3 6.7 6.7M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"></path>
          </svg>
        </button>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <p>© {new Date().getFullYear()} {AUTHOR.name}</p>
        <nav aria-label="Contact and profiles">
          <a class="footer-social" href={`mailto:${AUTHOR.email}`} aria-label="Email" title="Email">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <path d="m4 7 8 6 8-6"></path>
            </svg>
          </a>
          {SOCIAL.github && <a class="footer-social" href={SOCIAL.github} aria-label="GitHub" title="GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M15 22v-4.2c.04-1.03-.36-2.02-1.1-2.73 3.68-.41 7.55-1.81 7.55-8.18A6.38 6.38 0 0 0 19.75 2.5 5.93 5.93 0 0 0 19.59 0S18.53-.34 15 1.67a15.38 15.38 0 0 0-8 0C3.47-.34 2.41 0 2.41 0a5.93 5.93 0 0 0-.16 2.5A6.38 6.38 0 0 0 .55 6.9c0 6.35 3.87 7.75 7.55 8.18A3.7 3.7 0 0 0 7 17.65V22"></path>
              <path d="M7 19c-3 .92-3-1.5-4.2-2"></path>
            </svg>
          </a>}
          {SOCIAL.googleScholar && <a class="footer-social" href={SOCIAL.googleScholar} aria-label="Google Scholar" title="Google Scholar">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m2 9 10-5 10 5-10 5Z"></path>
              <path d="M6 12v5c3 2.2 9 2.2 12 0v-5"></path>
              <path d="M22 9v6"></path>
            </svg>
          </a>}
          {SOCIAL.orcid && <a class="footer-social" href={SOCIAL.orcid} aria-label="ORCID" title="ORCID">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M8.2 10.4v5.2"></path>
              <circle cx="8.2" cy="7.9" r=".65" class="footer-social-fill"></circle>
              <path d="M11.6 10.4h2.1a2.6 2.6 0 0 1 0 5.2h-2.1Z"></path>
            </svg>
          </a>}
        </nav>
      </div>
    </footer>
    <script>
      const themeButton = document.querySelector<HTMLButtonElement>('.theme-button');
      if (themeButton) {
        const moonIcon = themeButton.querySelector<SVGElement>('.theme-icon-moon');
        const sunIcon = themeButton.querySelector<SVGElement>('.theme-icon-sun');
        themeButton.hidden = false;
        const dark = () => document.documentElement.dataset.theme === 'dark' || (!document.documentElement.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
        const updateTheme = () => {
          const isDark = dark();
          const action = isDark ? 'Light theme' : 'Dark theme';
          themeButton.setAttribute('aria-label', action);
          themeButton.title = isDark ? 'Switch to light theme' : 'Switch to dark theme';
          if (moonIcon) moonIcon.hidden = isDark;
          if (sunIcon) sunIcon.hidden = !isDark;
        };
        updateTheme();
        matchMedia('(prefers-color-scheme: dark)').addEventListener('change', updateTheme);
        themeButton.addEventListener('click', () => {
          const next = dark() ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch {}
          updateTheme();
        });
      }

      const header = document.querySelector<HTMLElement>('[data-header]');
      const track = document.querySelector<HTMLElement>('[data-header-track]');
      if (header && track) {
        let scrollFrame = 0;
        let resizeFrame = 0;
        const shrinkAt = 96;
        const growAt = 28;

        const measure = () => {
          resizeFrame = 0;
          if (innerWidth < 780) {
            header.style.removeProperty('--header-compact');
            return;
          }
          const style = getComputedStyle(track);
          const gap = Number.parseFloat(style.columnGap) || 0;
          const visible = [...track.children].filter((child): child is HTMLElement =>
            child instanceof HTMLElement && child.getClientRects().length > 0
          );
          let width =
            Number.parseFloat(style.paddingLeft) +
            Number.parseFloat(style.paddingRight) +
            Number.parseFloat(style.borderLeftWidth) +
            Number.parseFloat(style.borderRightWidth);
          visible.forEach((child, index) => {
            width += child.getBoundingClientRect().width + (index ? gap : 0);
          });
          header.style.setProperty('--header-compact', `${Math.ceil(width + 4)}px`);
        };

        const apply = () => {
          scrollFrame = 0;
          const shrunk = header.dataset.shrunk === 'true';
          if (!shrunk && scrollY > shrinkAt) header.dataset.shrunk = 'true';
          else if (shrunk && scrollY < growAt) header.dataset.shrunk = 'false';
        };

        addEventListener('scroll', () => {
          if (scrollFrame) return;
          scrollFrame = requestAnimationFrame(apply);
        }, { passive: true });

        addEventListener('resize', () => {
          if (resizeFrame) return;
          resizeFrame = requestAnimationFrame(measure);
        }, { passive: true });

        document.fonts?.ready.then(measure).catch(() => {});
        measure();
        apply();
      }
    </script>
  </body>
</html>
